+"""Prediction service layer decoupling inference logic from FastAPI route handlers."""
+
+import json
+import logging
+from typing import Any
+
+import numpy as np
+from sqlalchemy.orm import Session
+
+from app.database import PredictionLog
+from app.faiss_index import FaissPatternMatcher
+from app.features import NUMERIC_FEATURES, prepare_features
+from app.model import MODEL_VERSION, predict
+from app.monitoring import DriftMonitor
+from app.schemas import NetworkTrafficRequest, PredictionResponse
+
+logger = logging.getLogger(__name__)
+
+
+class PredictionService:
+    """Orchestrates feature engineering, model inference, FAISS lookup, and logging.
+
+    Attributes:
+        model: Fitted VotingClassifier ensemble.
+        faiss: FAISS pattern matcher (may be None if unavailable).
+        monitor: KS-test drift monitor.
+    """
+
+    def __init__(
+        self,
+        model: Any,
+        faiss: FaissPatternMatcher | None,
+        monitor: DriftMonitor | None,
+    ) -> None:
+        """Initialise the service with its dependencies.
+
+        Args:
+            model: Fitted VotingClassifier.
+            faiss: Optional FAISS pattern matcher.
+            monitor: Optional drift monitor.
+        """
+        self.model = model
+        self.faiss = faiss
+        self.monitor = monitor
+        self._prediction_count = 0
+        self._attack_count = 0
+
+    @property
+    def prediction_count(self) -> int:
+        """Total number of predictions made since startup."""
+        return self._prediction_count
+
+    @property
+    def attack_count(self) -> int:
+        """Total number of attack predictions since startup."""
+        return self._attack_count
+
+    def run(
+        self,
+        request: NetworkTrafficRequest,
+        db: Session,
+    ) -> PredictionResponse:
+        """Execute the full prediction pipeline for one request.
+
+        Args:
+            request: Validated network traffic feature vector.
+            db: Active SQLAlchemy session for logging.
+
+        Returns:
+            PredictionResponse with label, confidence, and FAISS distance.
+        """
+        features_dict = request.model_dump(exclude={"source_ip", "destination_ip"})
+        df = prepare_features(features_dict)
+
+        labels, confidences = predict(self.model, df)
+        label = labels[0]
+        confidence = confidences[0]
+        is_attack = label != "normal"
+        attack_type = label if is_attack else None
+
+        faiss_dist: float | None = None
+        if self.faiss and self.faiss._n_vectors > 0:
+            vec = df[NUMERIC_FEATURES].values[0].astype(np.float32)
+            _, faiss_dist = self.faiss.is_anomaly(vec)
+
+        if self.monitor:
+            obs = {f: float(df[f].iloc[0]) for f in NUMERIC_FEATURES if f in df.columns}
+            self.monitor.observe(obs)
+
+        self._prediction_count += 1
+        if is_attack:
+            self._attack_count += 1
+
+        self._log_prediction(
+            request=request,
+            label=label,
+            confidence=confidence,
+            attack_type=attack_type,
+            features_dict=features_dict,
+            db=db,
+        )
+
+        return PredictionResponse(
+            prediction=label,
+            confidence=confidence,
+            attack_type=attack_type,
+            is_attack=is_attack,
+            model_version=MODEL_VERSION,
+            faiss_nearest_distance=faiss_dist,
+        )
+
+    def _log_prediction(
+        self,
+        request: NetworkTrafficRequest,
+        label: str,
+        confidence: float,
+        attack_type: str | None,
+        features_dict: dict[str, Any],
+        db: Session,
+    ) -> None:
+        """Persist the prediction to the database.
+
+        Args:
+            request: Original request with IP metadata.
+            label: Predicted class label.
+            confidence: Model confidence score.
+            attack_type: Attack class name or None.
+            features_dict: Raw features serialised to JSON.
+            db: Active SQLAlchemy session.
+        """
+        try:
+            log = PredictionLog(
+                source_ip=request.source_ip,
+                destination_ip=request.destination_ip,
+                protocol=request.protocol_type,
+                prediction=label,
+                confidence=confidence,
+                attack_type=attack_type,
+                raw_features=json.dumps(features_dict),
+                model_version=MODEL_VERSION,
+            )
+            db.add(log)
+            db.commit()
+        except Exception as exc:
+            logger.error("Failed to write prediction log: %s", exc)
+            db.rollback()
-- 
