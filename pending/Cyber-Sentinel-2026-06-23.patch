+
+    df = encode_categoricals(engineer_features(sample_traffic_df))
+    for col in NUMERIC_FEATURES:
+        if col not in df.columns:
+            df[col] = 0.0
+
+    batch = pd.concat([df[NUMERIC_FEATURES]] * n_samples, ignore_index=True)
+    mock_model.predict_proba.return_value = np.tile(
+        np.array([[0.9, 0.05, 0.05]]), (n_samples, 1)
+    )
+    mock_model.predict.return_value = ["normal"] * n_samples
+
+    labels, confs = predict(mock_model, batch)
+    assert len(labels) == n_samples
+    assert len(confs) == n_samples
