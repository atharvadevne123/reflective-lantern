diff --git a/app/faiss_index.py b/app/faiss_index.py
new file mode 100644
index 0000000..23af506
--- /dev/null
+++ b/app/faiss_index.py
@@ -0,0 +1,125 @@
+"""FAISS-based nearest-neighbour pattern matching for anomaly detection."""
+
+import logging
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+FAISS_INDEX_PATH = Path("models/faiss.index")
+FAISS_THRESHOLD = float(50.0)
+
+
+class FaissPatternMatcher:
+    """Wraps a FAISS flat-L2 index for fast nearest-neighbour lookup.
+
+    Used to compare incoming traffic vectors against known attack patterns
+    stored during training. A low distance suggests the sample resembles
+    a known attack signature.
+    """
+
+    def __init__(self, dimension: int, threshold: float = FAISS_THRESHOLD) -> None:
+        """Initialise an empty flat-L2 index.
+
+        Args:
+            dimension: Length of each feature vector.
+            threshold: L2 distance below which a match is flagged.
+        """
+        self.dimension = dimension
+        self.threshold = threshold
+        self._index: Any = None
+        self._n_vectors = 0
+        self._available = self._load_faiss()
+
+    def _load_faiss(self) -> bool:
+        """Attempt to import and initialise the FAISS index.
+
+        Returns:
+            True if FAISS is available, False otherwise.
+        """
+        try:
+            import faiss  # type: ignore[import]
+
+            self._index = faiss.IndexFlatL2(self.dimension)
+            logger.info("FAISS IndexFlatL2 initialised (dim=%d)", self.dimension)
+            return True
+        except ImportError:
+            logger.warning("FAISS not installed; pattern matching disabled")
+            return False
+
+    def add_vectors(self, vectors: np.ndarray) -> None:
+        """Add reference attack vectors to the index.
+
+        Args:
+            vectors: Float32 array of shape (n, dimension).
+        """
+        if not self._available or self._index is None:
+            return
+        vecs = vectors.astype(np.float32)
+        self._index.add(vecs)
+        self._n_vectors += len(vecs)
+        logger.info("Added %d vectors to FAISS index (total=%d)", len(vecs), self._n_vectors)
+
+    def search(self, vector: np.ndarray, k: int = 1) -> tuple[float, int]:
+        """Search for the nearest neighbour of a query vector.
+
+        Args:
+            vector: Query float32 array of shape (dimension,) or (1, dimension).
+            k: Number of nearest neighbours to return.
+
+        Returns:
+            Tuple of (minimum L2 distance, index of nearest neighbour).
+            Returns (float('inf'), -1) if the index is empty or unavailable.
+        """
+        if not self._available or self._index is None or self._n_vectors == 0:
+            return float("inf"), -1
+        query = vector.astype(np.float32).reshape(1, -1)
+        distances, indices = self._index.search(query, k)
+        return float(distances[0][0]), int(indices[0][0])
+
+    def is_anomaly(self, vector: np.ndarray) -> tuple[bool, float]:
+        """Return True if the vector is within threshold distance of a known attack.
+
+        Args:
+            vector: Feature vector to evaluate.
+
+        Returns:
+            Tuple of (is_anomaly bool, nearest_distance float).
+        """
+        dist, _ = self.search(vector)
+        return dist <= self.threshold, dist
+
+    def save(self, path: Path | None = None) -> None:
+        """Persist the FAISS index to disk.
+
+        Args:
+            path: Destination path; defaults to FAISS_INDEX_PATH.
+        """
+        if not self._available or self._index is None:
+            return
+        import faiss  # type: ignore[import]
+
+        dest = path or FAISS_INDEX_PATH
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        faiss.write_index(self._index, str(dest))
+        logger.info("FAISS index saved to %s", dest)
+
+    def load(self, path: Path | None = None) -> None:
+        """Load a persisted FAISS index from disk.
+
+        Args:
+            path: Source path; defaults to FAISS_INDEX_PATH.
+        """
+        if not self._available:
+            return
+        import faiss  # type: ignore[import]
+
+        src = path or FAISS_INDEX_PATH
+        if not src.exists():
+            logger.warning("FAISS index not found at %s", src)
+            return
+        self._index = faiss.read_index(str(src))
+        self._n_vectors = self._index.ntotal
+        logger.info("FAISS index loaded from %s (%d vectors)", src, self._n_vectors)
