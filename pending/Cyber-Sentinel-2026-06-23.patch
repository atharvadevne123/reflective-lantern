+import pandas as pd
+import pytest
+from sklearn.ensemble import RandomForestClassifier, VotingClassifier
+
+from app.model import build_model, predict, save_model, load_model, train, ATTACK_CLASSES
+
+
+def test_build_model_returns_voting_classifier() -> None:
+    model = build_model()
+    assert isinstance(model, VotingClassifier)
+    assert model.voting == "soft"
+
+
+def test_build_model_contains_random_forest() -> None:
+    model = build_model()
+    estimator_names = [name for name, _ in model.estimators]
+    assert "rf" in estimator_names
+
+
+def test_train_returns_model_and_metrics(synthetic_dataset) -> None:
+    X, y = synthetic_dataset
+    from app.features import encode_categoricals, engineer_features, NUMERIC_FEATURES
+
+    X_eng = engineer_features(X)
+    X_enc = encode_categoricals(X_eng)
+    X_num = X_enc[NUMERIC_FEATURES]
+
+    model, metrics = train(X_num, y, cv_folds=2)
+    assert isinstance(model, VotingClassifier)
+    assert "accuracy" in metrics
+    assert "f1_weighted" in metrics
+    assert 0.0 <= metrics["accuracy"] <= 1.0
+    assert 0.0 <= metrics["f1_weighted"] <= 1.0
+
+
+def test_train_metrics_include_cv_scores(synthetic_dataset) -> None:
+    X, y = synthetic_dataset
+    from app.features import encode_categoricals, engineer_features, NUMERIC_FEATURES
+
+    X_num = encode_categoricals(engineer_features(X))[NUMERIC_FEATURES]
+    _, metrics = train(X_num, y, cv_folds=2)
+    assert "cv_f1_mean" in metrics
+    assert "cv_f1_std" in metrics
+
+
+def test_predict_returns_labels_and_confidences(mock_model, sample_traffic_df) -> None:
+    from app.features import encode_categoricals, engineer_features, NUMERIC_FEATURES
+
+    df = encode_categoricals(engineer_features(sample_traffic_df))
+    for col in NUMERIC_FEATURES:
+        if col not in df.columns:
+            df[col] = 0.0
+
+    labels, confs = predict(mock_model, df[NUMERIC_FEATURES])
+    assert isinstance(labels, list)
+    assert isinstance(confs, list)
+    assert len(labels) == 1
+    assert 0.0 <= confs[0] <= 1.0
+
+
+def test_predict_confidence_sums_near_one(mock_model, sample_traffic_df) -> None:
+    from app.features import NUMERIC_FEATURES, encode_categoricals, engineer_features
+
+    df = encode_categoricals(engineer_features(sample_traffic_df))
+    for col in NUMERIC_FEATURES:
+        if col not in df.columns:
+            df[col] = 0.0
+
+    mock_model.predict_proba.return_value = np.array([[0.6, 0.3, 0.1]])
+    _, confs = predict(mock_model, df[NUMERIC_FEATURES])
+    assert confs[0] == pytest.approx(0.9, abs=0.01)
+
+
+def test_save_and_load_model(synthetic_dataset) -> None:
+    X, y = synthetic_dataset
+    from app.features import encode_categoricals, engineer_features, NUMERIC_FEATURES
+
+    X_num = encode_categoricals(engineer_features(X))[NUMERIC_FEATURES]
+    model, _ = train(X_num, y, cv_folds=2)
+
+    with tempfile.TemporaryDirectory() as tmpdir:
