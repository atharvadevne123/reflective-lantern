+def test_add_vectors_increases_count(matcher: FaissPatternMatcher, n_vectors: int) -> None:
+    if not matcher._available:
+        pytest.skip("FAISS not installed")
+    vecs = np.random.default_rng(0).uniform(0, 1, (n_vectors, 10)).astype(np.float32)
+    matcher.add_vectors(vecs)
+    assert matcher._n_vectors == n_vectors
+
+
+def test_exact_match_returns_zero_distance(matcher: FaissPatternMatcher) -> None:
+    if not matcher._available:
+        pytest.skip("FAISS not installed")
+    vec = np.ones(10, dtype=np.float32)
+    matcher.add_vectors(vec.reshape(1, -1))
+    dist, idx = matcher.search(vec)
+    assert dist == pytest.approx(0.0, abs=1e-4)
+
+
+def test_anomaly_detected_near_known_vector(matcher: FaissPatternMatcher) -> None:
+    if not matcher._available:
+        pytest.skip("FAISS not installed")
+    known = np.zeros(10, dtype=np.float32)
+    matcher.add_vectors(known.reshape(1, -1))
+    close = known + 0.1
+    is_anom, dist = matcher.is_anomaly(close)
+    assert is_anom is True
+
+
+def test_no_anomaly_for_distant_vector(matcher: FaissPatternMatcher) -> None:
+    if not matcher._available:
+        pytest.skip("FAISS not installed")
+    known = np.zeros(10, dtype=np.float32)
+    matcher.add_vectors(known.reshape(1, -1))
+    far = np.ones(10, dtype=np.float32) * 100.0
+    is_anom, dist = matcher.is_anomaly(far)
