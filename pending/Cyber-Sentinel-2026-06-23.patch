diff --git a/app/health.py b/app/health.py
new file mode 100644
index 0000000..36ffc8e
--- /dev/null
+++ b/app/health.py
@@ -0,0 +1,77 @@
+"""Health-check helper that reports detailed system and dependency status."""
+
+import logging
+import os
+import platform
+import sys
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+def get_system_info() -> dict[str, str]:
+    """Return basic OS and Python runtime information.
+
+    Returns:
+        Dict with keys: python_version, platform, pid.
+    """
+    return {
+        "python_version": sys.version.split()[0],
+        "platform": platform.system(),
+        "pid": str(os.getpid()),
+    }
+
+
+def check_database(database_url: str) -> dict[str, Any]:
+    """Verify the database is reachable by executing a trivial query.
+
+    Args:
+        database_url: SQLAlchemy connection string.
+
+    Returns:
+        Dict with 'status' ('ok' or 'error') and optional 'error' message.
+    """
+    try:
+        from sqlalchemy import create_engine, text
+
+        engine = create_engine(database_url, pool_pre_ping=True)
+        with engine.connect() as conn:
+            conn.execute(text("SELECT 1"))
+        return {"status": "ok"}
+    except Exception as exc:
+        logger.error("Database health check failed: %s", exc)
+        return {"status": "error", "error": str(exc)}
+
+
+def check_model(model_path: str) -> dict[str, Any]:
+    """Check whether the model file exists and is readable.
+
+    Args:
+        model_path: Filesystem path to the model pickle.
+
+    Returns:
+        Dict with 'status' and optional 'size_bytes'.
+    """
+    from pathlib import Path
+
+    p = Path(model_path)
+    if not p.exists():
+        return {"status": "missing"}
+    return {"status": "ok", "size_bytes": p.stat().st_size}
+
+
+def full_health_report(database_url: str, model_path: str) -> dict[str, Any]:
+    """Assemble a complete health report for the /health/detailed endpoint.
+
+    Args:
+        database_url: Database connection string.
+        model_path: Path to the trained model.
+
+    Returns:
+        Nested dict with system, database, and model status.
+    """
+    return {
+        "system": get_system_info(),
+        "database": check_database(database_url),
+        "model": check_model(model_path),
+    }
-- 
