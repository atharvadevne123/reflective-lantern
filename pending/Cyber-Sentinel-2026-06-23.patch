+"""FastAPI application for the Cyber-Sentinel intrusion detection service."""
+
+import json
+import logging
+import os
+import time
+import uuid
+from contextlib import asynccontextmanager
+from typing import AsyncGenerator
+
+import numpy as np
+from fastapi import Depends, FastAPI, HTTPException, Request, Response
+from fastapi.middleware.cors import CORSMiddleware
+from sqlalchemy.orm import Session
+
+from app.database import PredictionLog, get_db, init_db
+from app.faiss_index import FaissPatternMatcher
+from app.features import NUMERIC_FEATURES, engineer_features, encode_categoricals, prepare_features
+from app.model import MODEL_VERSION, load_model, predict
+from app.monitoring import DriftMonitor
+from app.schemas import (
+    BatchPredictionRequest,
+    BatchPredictionResponse,
+    HealthResponse,
+    MetricsResponse,
+    NetworkTrafficRequest,
+    PredictionResponse,
+)
+
+logger = logging.getLogger(__name__)
+logging.basicConfig(
+    level=os.getenv("LOG_LEVEL", "INFO"),
+    format="%(asctime)s [%(levelname)s] %(name)s %(message)s",
+)
+
+_model = None
+_faiss: FaissPatternMatcher | None = None
+_monitor: DriftMonitor | None = None
+_prediction_count = 0
+_attack_count = 0
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI) -> AsyncGenerator[None, None]:
+    """Initialise ML model, FAISS index, and drift monitor on startup."""
+    global _model, _faiss, _monitor
+    init_db()
+    try:
+        _model = load_model()
+        logger.info("Model loaded successfully (version=%s)", MODEL_VERSION)
+    except FileNotFoundError:
+        logger.warning("No pre-trained model found; /predict will return 503 until model is trained")
+
+    _faiss = FaissPatternMatcher(dimension=len(NUMERIC_FEATURES))
+    _monitor = DriftMonitor(feature_names=NUMERIC_FEATURES[:10])
+    logger.info("Drift monitor initialised")
+    yield
+    logger.info("Shutting down Cyber-Sentinel")
+
+
+app = FastAPI(
+    title="Cyber-Sentinel",
+    description="Real-time network intrusion detection using XGBoost/LightGBM/RF ensemble",
+    version=MODEL_VERSION,
+    lifespan=lifespan,
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+
+@app.middleware("http")
+async def correlation_id_middleware(request: Request, call_next: object) -> Response:
+    """Attach a correlation ID to every request for tracing."""
+    correlation_id = request.headers.get("X-Correlation-ID", str(uuid.uuid4()))
+    start = time.perf_counter()
+    response: Response = await call_next(request)  # type: ignore[arg-type,misc]
+    elapsed = time.perf_counter() - start
+    response.headers["X-Correlation-ID"] = correlation_id
+    response.headers["X-Response-Time"] = f"{elapsed:.4f}s"
+    logger.info(
+        "method=%s path=%s status=%d duration=%.4fs corr=%s",
+        request.method,
+        request.url.path,
+        response.status_code,
+        elapsed,
+        correlation_id,
+    )
+    return response
+
+
+@app.get("/health", response_model=HealthResponse, tags=["Operations"])
+def health() -> HealthResponse:
+    """Return service health status and model availability."""
+    return HealthResponse(
+        status="ok",
+        model_loaded=_model is not None,
+        version=MODEL_VERSION,
+    )
+
+
+@app.get("/version", tags=["Operations"])
+def version() -> dict[str, str]:
+    """Return the current model and API version."""
+    return {"model_version": MODEL_VERSION, "api_version": "1.0.0"}
+
+
+@app.get("/metrics", response_model=MetricsResponse, tags=["Operations"])
+def metrics() -> MetricsResponse:
+    """Return aggregate prediction counts and drift statistics."""
+    global _prediction_count, _attack_count, _monitor
+    recent_attack_rate = _attack_count / max(_prediction_count, 1)
+    drift_summary = _monitor.drift_summary() if _monitor else {"drifted": 0, "clean": 0}
+    return MetricsResponse(
+        total_predictions=_prediction_count,
+        drift_summary=drift_summary,
+        recent_attack_rate=round(recent_attack_rate, 4),
+    )
+
+
+@app.post(
+    "/api/v1/predict",
+    response_model=PredictionResponse,
+    tags=["Inference"],
+    summary="Classify a single network traffic record",
+)
+def predict_single(
+    body: NetworkTrafficRequest,
+    db: Session = Depends(get_db),
+) -> PredictionResponse:
+    """Classify one network traffic record and log the result.
+
+    Args:
+        body: Validated network traffic feature vector.
+        db: SQLAlchemy session (injected).
+
+    Returns:
+        PredictionResponse with class label, confidence, and FAISS distance.
+
+    Raises:
+        HTTPException 503: If the model has not been loaded yet.
+    """
+    global _model, _faiss, _monitor, _prediction_count, _attack_count
+
+    if _model is None:
+        raise HTTPException(status_code=503, detail="Model not loaded — run training first")
+
+    features_dict = body.model_dump(exclude={"source_ip", "destination_ip"})
+    df = prepare_features(features_dict)
+
+    labels, confidences = predict(_model, df)
+    label = labels[0]
+    confidence = confidences[0]
+    is_attack = label != "normal"
+    attack_type = label if is_attack else None
+
+    faiss_dist: float | None = None
+    if _faiss and _faiss._n_vectors > 0:
+        vec = df[NUMERIC_FEATURES].values[0].astype(np.float32)
+        _, faiss_dist = _faiss.is_anomaly(vec)
+
+    if _monitor:
+        obs = {f: float(df[f].iloc[0]) for f in NUMERIC_FEATURES if f in df.columns}
+        _monitor.observe(obs)
+
+    _prediction_count += 1
+    if is_attack:
+        _attack_count += 1
+
+    try:
+        log = PredictionLog(
+            source_ip=body.source_ip,
+            destination_ip=body.destination_ip,
+            protocol=body.protocol_type,
+            prediction=label,
+            confidence=confidence,
+            attack_type=attack_type,
+            raw_features=json.dumps(features_dict),
+            model_version=MODEL_VERSION,
+        )
+        db.add(log)
+        db.commit()
+    except Exception as exc:
+        logger.error("Failed to write prediction log: %s", exc)
+        db.rollback()
+
+    return PredictionResponse(
+        prediction=label,
+        confidence=confidence,
+        attack_type=attack_type,
+        is_attack=is_attack,
+        model_version=MODEL_VERSION,
+        faiss_nearest_distance=faiss_dist,
+    )
+
+
+@app.post(
+    "/api/v1/predict/batch",
+    response_model=BatchPredictionResponse,
+    tags=["Inference"],
+    summary="Classify a batch of network traffic records",
+)
+def predict_batch(
+    body: BatchPredictionRequest,
+    db: Session = Depends(get_db),
+) -> BatchPredictionResponse:
+    """Run batch inference on up to 1000 traffic records.
+
+    Args:
+        body: Batch of NetworkTrafficRequest records.
+        db: SQLAlchemy session (injected).
+
+    Returns:
+        BatchPredictionResponse with one PredictionResponse per input record.
+    """
+    results = [
+        predict_single(record, db)
+        for record in body.records
+    ]
+    return BatchPredictionResponse(predictions=results, total=len(results))
