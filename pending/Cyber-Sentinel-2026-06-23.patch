+import argparse
+import logging
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+
+def _generate_synthetic_data(n: int = 5000) -> tuple[pd.DataFrame, pd.Series]:
+    """Generate synthetic KDD-Cup-style data for smoke-test training.
+
+    Args:
+        n: Number of samples to generate.
+
+    Returns:
+        Tuple of (feature DataFrame, label Series).
+    """
+    from app.features import CATEGORICAL_FEATURES, NUMERIC_FEATURES
+
+    rng = np.random.default_rng(42)
+    data: dict[str, object] = {}
+    for feat in NUMERIC_FEATURES:
+        data[feat] = rng.uniform(0, 100, n)
+    for cat in CATEGORICAL_FEATURES:
+        if cat == "protocol_type":
+            data[cat] = rng.choice(["tcp", "udp", "icmp"], n)
+        elif cat == "service":
+            data[cat] = rng.choice(["http", "ftp", "smtp", "ssh"], n)
+        else:
+            data[cat] = rng.choice(["SF", "S0", "REJ", "RSTO"], n)
+
+    labels = rng.choice(["normal", "dos", "probe", "r2l", "u2r"], n, p=[0.6, 0.2, 0.1, 0.06, 0.04])
+    return pd.DataFrame(data), pd.Series(labels, name="label")
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Entry point for the training script.
+
+    Args:
+        argv: Command-line arguments; defaults to sys.argv.
+
+    Returns:
+        Exit code (0 = success, 1 = failure).
+    """
+    parser = argparse.ArgumentParser(description="Train Cyber-Sentinel ensemble")
+    parser.add_argument("--data", type=Path, default=None, help="Path to CSV training data")
+    parser.add_argument("--output", type=Path, default=Path("models/ensemble.pkl"))
+    parser.add_argument("--cv-folds", type=int, default=5)
+    parser.add_argument("--synthetic", action="store_true", help="Use synthetic data for smoke test")
+    args = parser.parse_args(argv)
+
+    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
+
+    from app.features import NUMERIC_FEATURES, encode_categoricals, engineer_features
+    from app.model import save_model, train
+
+    try:
+        if args.data and not args.synthetic:
+            logger.info("Loading data from %s", args.data)
+            df = pd.read_csv(args.data)
+            y = df["label"]
+            X = df.drop(columns=["label"])
+        else:
+            logger.info("Generating synthetic training data")
+            X, y = _generate_synthetic_data()
+
+        X = engineer_features(X)
+        X = encode_categoricals(X)
+        X_num = X[NUMERIC_FEATURES]
+
+        model, metrics = train(X_num, y, cv_folds=args.cv_folds)
+        save_model(model, args.output)
+        logger.info("Training complete. Metrics: %s", metrics)
+        return 0
+    except Exception as exc:
+        logger.error("Training failed: %s", exc, exc_info=True)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
