--- /dev/null
+++ b/app/features.py
@@ -0,0 +1,141 @@
+"""Feature engineering pipeline for network traffic data."""
+
+import logging
+from typing import Any
+
+import numpy as np
+import pandas as pd
+from sklearn.compose import ColumnTransformer
+from sklearn.pipeline import Pipeline
+from sklearn.preprocessing import LabelEncoder, MinMaxScaler, StandardScaler
+
+logger = logging.getLogger(__name__)
+
+NUMERIC_FEATURES = [
+    "duration",
+    "src_bytes",
+    "dst_bytes",
+    "land",
+    "wrong_fragment",
+    "urgent",
+    "hot",
+    "num_failed_logins",
+    "logged_in",
+    "num_compromised",
+    "root_shell",
+    "su_attempted",
+    "num_root",
+    "num_file_creations",
+    "num_shells",
+    "num_access_files",
+    "num_outbound_cmds",
+    "is_host_login",
+    "is_guest_login",
+    "count",
+    "srv_count",
+    "serror_rate",
+    "srv_serror_rate",
+    "rerror_rate",
+    "srv_rerror_rate",
+    "same_srv_rate",
+    "diff_srv_rate",
+    "srv_diff_host_rate",
+    "dst_host_count",
+    "dst_host_srv_count",
+    "dst_host_same_srv_rate",
+    "dst_host_diff_srv_rate",
+    "dst_host_same_src_port_rate",
+    "dst_host_srv_diff_host_rate",
+    "dst_host_serror_rate",
+    "dst_host_srv_serror_rate",
+    "dst_host_rerror_rate",
+    "dst_host_srv_rerror_rate",
+]
+
+CATEGORICAL_FEATURES = ["protocol_type", "service", "flag"]
+
+ALL_FEATURES = NUMERIC_FEATURES + CATEGORICAL_FEATURES
+
+
+def build_feature_pipeline() -> Pipeline:
+    """Build a sklearn Pipeline for numeric scaling and categorical encoding.
+
+    Returns:
+        A fitted-ready Pipeline with StandardScaler for numeric features
+        and MinMaxScaler for the derived ratio columns.
+    """
+    numeric_transformer = Pipeline(
+        steps=[("scaler", StandardScaler())]
+    )
+
+    preprocessor = ColumnTransformer(
+        transformers=[
+            ("num", numeric_transformer, NUMERIC_FEATURES),
+        ],
+        remainder="drop",
+    )
+
+    pipeline = Pipeline(steps=[("preprocessor", preprocessor)])
+    return pipeline
+
+
+def engineer_features(df: pd.DataFrame) -> pd.DataFrame:
+    """Derive additional features from raw network traffic columns.
+
+    Args:
+        df: Raw network traffic DataFrame.
+
+    Returns:
+        DataFrame with additional engineered columns appended.
+    """
+    df = df.copy()
+
+    if "src_bytes" in df.columns and "dst_bytes" in df.columns:
+        total = df["src_bytes"] + df["dst_bytes"]
+        df["bytes_ratio"] = df["src_bytes"] / (total + 1e-9)
+        df["log_src_bytes"] = np.log1p(df["src_bytes"])
+        df["log_dst_bytes"] = np.log1p(df["dst_bytes"])
+
+    if "serror_rate" in df.columns and "rerror_rate" in df.columns:
+        df["total_error_rate"] = df["serror_rate"] + df["rerror_rate"]
+
+    if "count" in df.columns and "srv_count" in df.columns:
+        df["srv_ratio"] = df["srv_count"] / (df["count"] + 1e-9)
+
+    logger.debug("Engineered %d features for %d rows", len(df.columns), len(df))
+    return df
+
+
+def encode_categoricals(df: pd.DataFrame) -> pd.DataFrame:
+    """Label-encode categorical columns in place.
+
+    Args:
+        df: DataFrame containing CATEGORICAL_FEATURES columns.
+
+    Returns:
+        DataFrame with categorical columns replaced by integer codes.
+    """
+    df = df.copy()
+    for col in CATEGORICAL_FEATURES:
+        if col in df.columns:
+            le = LabelEncoder()
+            df[col] = le.fit_transform(df[col].astype(str))
+    return df
+
+
+def prepare_features(raw: dict[str, Any]) -> pd.DataFrame:
+    """Convert a raw request dict into a feature DataFrame ready for inference.
+
+    Args:
+        raw: Dictionary of feature name → value from the API request.
+
+    Returns:
+        Single-row DataFrame with all engineered features.
+    """
+    df = pd.DataFrame([raw])
+    for col in ALL_FEATURES:
+        if col not in df.columns:
+            df[col] = 0
+    df = engineer_features(df)
+    df = encode_categoricals(df)
+    return df
-- 
