From: Reflective Lantern <devneatharva@gmail.com>
Date: Tue, 23 Jun 2026 10:09:27 +0000
Subject: [PATCH 04/60] feat(4/60): add XGBoost-LightGBM-RF ensemble model with
 5-fold CV

---
 app/model.py | 194 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 194 insertions(+)
 create mode 100644 app/model.py

diff --git a/app/model.py b/app/model.py
new file mode 100644
index 0000000..32961ad
--- /dev/null
+++ b/app/model.py
@@ -0,0 +1,194 @@
+"""XGBoost/LightGBM/RandomForest ensemble model for intrusion detection."""
+
+import logging
+import os
+import pickle
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+from sklearn.ensemble import RandomForestClassifier, VotingClassifier
+from sklearn.metrics import accuracy_score, f1_score, roc_auc_score
+from sklearn.model_selection import StratifiedKFold, cross_val_score
+
+logger = logging.getLogger(__name__)
+
+MODEL_PATH = Path(os.getenv("MODEL_PATH", "models/ensemble.pkl"))
+MODEL_VERSION = os.getenv("MODEL_VERSION", "1.0.0")
+
+ATTACK_CLASSES = [
+    "normal",
+    "dos",
+    "probe",
+    "r2l",
+    "u2r",
+]
+
+
+def _build_estimators() -> list[tuple[str, Any]]:
+    """Instantiate the three ensemble members.
+
+    Returns:
+        List of (name, estimator) tuples for VotingClassifier.
+    """
+    estimators: list[tuple[str, Any]] = []
+
+    try:
+        from xgboost import XGBClassifier
+
+        xgb = XGBClassifier(
+            n_estimators=200,
+            max_depth=6,
+            learning_rate=0.05,
+            subsample=0.8,
+            colsample_bytree=0.8,
+            use_label_encoder=False,
+            eval_metric="mlogloss",
+            random_state=42,
+        )
+        estimators.append(("xgb", xgb))
+    except ImportError:
+        logger.warning("XGBoost not available; skipping")
+
+    try:
+        from lightgbm import LGBMClassifier
+
+        lgbm = LGBMClassifier(
+            n_estimators=200,
+            max_depth=6,
+            learning_rate=0.05,
+            subsample=0.8,
+            random_state=42,
+            verbose=-1,
+        )
+        estimators.append(("lgbm", lgbm))
+    except ImportError:
+        logger.warning("LightGBM not available; skipping")
+
+    rf = RandomForestClassifier(
+        n_estimators=200,
+        max_depth=8,
+        min_samples_split=5,
+        random_state=42,
+        n_jobs=-1,
+    )
+    estimators.append(("rf", rf))
+
+    return estimators
+
+
+def build_model() -> VotingClassifier:
+    """Build the ensemble VotingClassifier with soft voting.
+
+    Returns:
+        Untrained VotingClassifier wrapping XGBoost, LightGBM, and RandomForest.
+    """
+    estimators = _build_estimators()
+    model = VotingClassifier(estimators=estimators, voting="soft")
+    return model
+
+
+def train(
+    X: pd.DataFrame,
+    y: pd.Series,
+    cv_folds: int = 5,
+) -> tuple[VotingClassifier, dict[str, float]]:
+    """Train the ensemble and evaluate with stratified k-fold cross-validation.
+
+    Args:
+        X: Feature matrix.
+        y: Target labels.
+        cv_folds: Number of CV folds.
+
+    Returns:
+        Tuple of (fitted model, metrics dict with accuracy, f1, auc_roc).
+    """
+    model = build_model()
+    logger.info("Training ensemble on %d samples with %d-fold CV", len(X), cv_folds)
+
+    cv = StratifiedKFold(n_splits=cv_folds, shuffle=True, random_state=42)
+    cv_scores = cross_val_score(model, X, y, cv=cv, scoring="f1_weighted", n_jobs=-1)
+    logger.info("CV F1 scores: %s (mean=%.4f)", cv_scores, cv_scores.mean())
+
+    model.fit(X, y)
+
+    y_pred = model.predict(X)
+    y_proba = model.predict_proba(X)
+
+    metrics: dict[str, float] = {
+        "accuracy": float(accuracy_score(y, y_pred)),
+        "f1_weighted": float(f1_score(y, y_pred, average="weighted")),
+        "cv_f1_mean": float(cv_scores.mean()),
+        "cv_f1_std": float(cv_scores.std()),
+    }
+
+    try:
+        metrics["auc_roc"] = float(
+            roc_auc_score(y, y_proba, multi_class="ovr", average="weighted")
+        )
+    except Exception:
+        metrics["auc_roc"] = 0.0
+
+    logger.info("Train metrics: %s", metrics)
+    return model, metrics
+
+
+def save_model(model: VotingClassifier, path: Path | None = None) -> Path:
+    """Serialise the model to disk with pickle.
+
+    Args:
+        model: Fitted VotingClassifier.
+        path: Destination path; defaults to MODEL_PATH.
+
+    Returns:
+        Path where the model was saved.
+    """
+    dest = path or MODEL_PATH
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    with open(dest, "wb") as f:
+        pickle.dump(model, f)
+    logger.info("Model saved to %s", dest)
+    return dest
+
+
+def load_model(path: Path | None = None) -> VotingClassifier:
+    """Load a serialised model from disk.
+
+    Args:
+        path: Source path; defaults to MODEL_PATH.
+
+    Returns:
+        Fitted VotingClassifier.
+
+    Raises:
+        FileNotFoundError: If the model file does not exist.
+    """
+    src = path or MODEL_PATH
+    if not src.exists():
+        raise FileNotFoundError(f"Model not found at {src}")
+    with open(src, "rb") as f:
+        model = pickle.load(f)
+    logger.info("Model loaded from %s", src)
+    return model
+
+
+def predict(
+    model: VotingClassifier,
+    X: pd.DataFrame,
+) -> tuple[list[str], list[float]]:
+    """Run inference and return class labels with confidence scores.
+
+    Args:
+        model: Fitted VotingClassifier.
+        X: Feature matrix (one or more rows).
+
+    Returns:
+        Tuple of (list of predicted class names, list of max-class probabilities).
+    """
+    proba = model.predict_proba(X)
+    indices = np.argmax(proba, axis=1)
+    classes = model.classes_
+    labels = [str(classes[i]) for i in indices]
+    confidences = [float(proba[row, indices[row]]) for row in range(len(X))]
+    return labels, confidences
-- 
