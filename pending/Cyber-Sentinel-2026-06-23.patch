+"""Simple in-memory LRU cache for repeated expensive lookups."""
+
+import functools
+import logging
+from typing import Any, Callable, TypeVar
+
+logger = logging.getLogger(__name__)
+
+F = TypeVar("F", bound=Callable[..., Any])
+
+
+def lru_cached(maxsize: int = 128) -> Callable[[F], F]:
+    """Decorator that wraps functools.lru_cache and logs cache statistics.
+
+    Args:
+        maxsize: Maximum number of entries in the cache.
+
+    Returns:
+        Decorator function.
+    """
+
+    def decorator(func: F) -> F:
+        cached = functools.lru_cache(maxsize=maxsize)(func)
+
+        @functools.wraps(func)
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            result = cached(*args, **kwargs)
+            info = cached.cache_info()
+            logger.debug(
+                "%s cache: hits=%d misses=%d size=%d",
+                func.__qualname__,
+                info.hits,
+                info.misses,
+                info.currsize,
+            )
+            return result
+
+        wrapper.cache_info = cached.cache_info  # type: ignore[attr-defined]
+        wrapper.cache_clear = cached.cache_clear  # type: ignore[attr-defined]
+        return wrapper  # type: ignore[return-value]
+
+    return decorator
+
+
+@lru_cached(maxsize=32)
+def get_feature_names_cached(feature_set: str) -> tuple[str, ...]:
+    """Return feature name tuples for a named feature set (cached).
+
+    Args:
+        feature_set: One of 'numeric', 'categorical', 'all'.
+
+    Returns:
+        Tuple of feature name strings.
+
+    Raises:
+        ValueError: If feature_set is not recognised.
+    """
+    from app.features import ALL_FEATURES, CATEGORICAL_FEATURES, NUMERIC_FEATURES
+
+    mapping = {
+        "numeric": tuple(NUMERIC_FEATURES),
+        "categorical": tuple(CATEGORICAL_FEATURES),
+        "all": tuple(ALL_FEATURES),
+    }
+    if feature_set not in mapping:
+        raise ValueError(f"Unknown feature set '{feature_set}'. Choose from {list(mapping)}")
+    return mapping[feature_set]
