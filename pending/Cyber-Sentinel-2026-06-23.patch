+"""Generate synthetic KDD-Cup-style labelled CSV data for local testing."""
+
+import argparse
+import logging
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+
+def generate(n: int = 10000, seed: int = 42) -> pd.DataFrame:
+    """Generate n synthetic network traffic records with attack labels.
+
+    Args:
+        n: Number of rows to generate.
+        seed: Random seed for reproducibility.
+
+    Returns:
+        DataFrame with feature columns and a 'label' column.
+    """
+    from app.features import CATEGORICAL_FEATURES, NUMERIC_FEATURES
+
+    rng = np.random.default_rng(seed)
+    data: dict[str, object] = {}
+
+    for feat in NUMERIC_FEATURES:
+        if "rate" in feat:
+            data[feat] = rng.uniform(0.0, 1.0, n)
+        elif "bytes" in feat:
+            data[feat] = rng.integers(0, 50000, n)
+        elif "count" in feat:
+            data[feat] = rng.integers(0, 512, n)
+        else:
+            data[feat] = rng.uniform(0, 100, n)
+
+    for cat in CATEGORICAL_FEATURES:
+        if cat == "protocol_type":
+            data[cat] = rng.choice(["tcp", "udp", "icmp"], n, p=[0.7, 0.2, 0.1])
+        elif cat == "service":
+            data[cat] = rng.choice(["http", "ftp", "smtp", "ssh", "telnet"], n)
+        else:
+            data[cat] = rng.choice(["SF", "S0", "REJ", "RSTO", "SH"], n)
+
+    labels = rng.choice(
+        ["normal", "dos", "probe", "r2l", "u2r"],
+        n,
+        p=[0.60, 0.22, 0.10, 0.06, 0.02],
+    )
+    data["label"] = labels
+
+    return pd.DataFrame(data)
+
+
+def main(argv: list[str] | None = None) -> int:
+    """CLI entry point.
+
+    Args:
+        argv: Command-line arguments.
+
+    Returns:
+        Exit code.
+    """
+    parser = argparse.ArgumentParser(description="Generate synthetic training data")
+    parser.add_argument("--n", type=int, default=10000, help="Number of rows")
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--output", type=Path, default=Path("data/train.csv"))
+    args = parser.parse_args(argv)
+
+    logging.basicConfig(level=logging.INFO)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+
+    df = generate(n=args.n, seed=args.seed)
+    df.to_csv(args.output, index=False)
+    logger.info("Wrote %d rows to %s", len(df), args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
-- 
