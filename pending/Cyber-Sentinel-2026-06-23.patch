+"""Evaluate a trained Cyber-Sentinel model against a labelled test CSV."""
+
+import argparse
+import logging
+import sys
+from pathlib import Path
+
+import pandas as pd
+from sklearn.metrics import classification_report, confusion_matrix
+
+logger = logging.getLogger(__name__)
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run evaluation and print classification report.
+
+    Args:
+        argv: Command-line arguments; defaults to sys.argv.
+
+    Returns:
+        Exit code (0 = success, 1 = failure).
+    """
+    parser = argparse.ArgumentParser(description="Evaluate Cyber-Sentinel model")
+    parser.add_argument("--data", type=Path, required=True, help="CSV with features + 'label' col")
+    parser.add_argument("--model", type=Path, default=Path("models/ensemble.pkl"))
+    args = parser.parse_args(argv)
+
+    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
+
+    from app.features import NUMERIC_FEATURES, encode_categoricals, engineer_features
+    from app.model import load_model, predict
+
+    try:
+        df = pd.read_csv(args.data)
+        y_true = df["label"]
+        X = df.drop(columns=["label"])
+        X = engineer_features(X)
+        X = encode_categoricals(X)
+        X_num = X[NUMERIC_FEATURES]
+
+        model = load_model(args.model)
+        labels, _ = predict(model, X_num)
+
+        report = classification_report(y_true, labels, zero_division=0)
+        print(report)
+
+        cm = confusion_matrix(y_true, labels, labels=model.classes_)
+        logger.info("Confusion matrix:\n%s", cm)
+        return 0
+    except Exception as exc:
+        logger.error("Evaluation failed: %s", exc, exc_info=True)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
