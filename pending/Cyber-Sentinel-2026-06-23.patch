@@ -0,0 +1,102 @@
+"""Quick latency benchmark for the /api/v1/predict endpoint."""
+
+import argparse
+import json
+import logging
+import statistics
+import sys
+import time
+import urllib.request
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+SAMPLE_PAYLOAD: dict[str, Any] = {
+    "duration": 1.5,
+    "protocol_type": "tcp",
+    "service": "http",
+    "flag": "SF",
+    "src_bytes": 1000,
+    "dst_bytes": 2000,
+    "count": 10,
+    "srv_count": 10,
+    "serror_rate": 0.0,
+    "rerror_rate": 0.0,
+    "same_srv_rate": 1.0,
+    "diff_srv_rate": 0.0,
+    "dst_host_count": 20,
+    "dst_host_srv_count": 20,
+}
+
+
+def benchmark(url: str, n: int, concurrency: int = 1) -> dict[str, float]:
+    """Send n sequential POST requests and collect latency statistics.
+
+    Args:
+        url: Full URL of the /api/v1/predict endpoint.
+        n: Number of requests to send.
+        concurrency: Reserved for future parallel implementation.
+
+    Returns:
+        Dict with min, max, mean, median, p95, p99 latencies in milliseconds.
+    """
+    payload = json.dumps(SAMPLE_PAYLOAD).encode()
+    latencies: list[float] = []
+
+    for i in range(n):
+        req = urllib.request.Request(
+            url,
+            data=payload,
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        start = time.perf_counter()
+        try:
+            with urllib.request.urlopen(req, timeout=10):
+                pass
+        except Exception as exc:
+            logger.warning("Request %d failed: %s", i, exc)
+            continue
+        latencies.append((time.perf_counter() - start) * 1000)
+
+    if not latencies:
+        return {}
+
+    sorted_lat = sorted(latencies)
+    return {
+        "n": len(latencies),
+        "min_ms": sorted_lat[0],
+        "max_ms": sorted_lat[-1],
+        "mean_ms": statistics.mean(latencies),
+        "median_ms": statistics.median(latencies),
+        "p95_ms": sorted_lat[int(0.95 * len(sorted_lat))],
+        "p99_ms": sorted_lat[int(0.99 * len(sorted_lat))],
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    """CLI entry point for the benchmark script.
+
+    Args:
+        argv: Command-line arguments.
+
+    Returns:
+        Exit code.
+    """
+    parser = argparse.ArgumentParser(description="Benchmark /api/v1/predict endpoint")
+    parser.add_argument("--url", default="http://localhost:8000/api/v1/predict")
+    parser.add_argument("--n", type=int, default=100, help="Number of requests")
+    args = parser.parse_args(argv)
+
+    logging.basicConfig(level=logging.INFO)
+    stats = benchmark(url=args.url, n=args.n)
+    if stats:
+        print(json.dumps(stats, indent=2))
+    else:
+        print("No successful requests")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
