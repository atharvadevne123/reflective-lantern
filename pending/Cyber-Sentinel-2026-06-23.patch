--- /dev/null
+++ b/app/utils.py
@@ -0,0 +1,94 @@
+"""General-purpose utility functions for Cyber-Sentinel."""
+
+import functools
+import hashlib
+import json
+import logging
+import time
+from typing import Any, Callable, TypeVar
+
+logger = logging.getLogger(__name__)
+
+F = TypeVar("F", bound=Callable[..., Any])
+
+
+def timer(func: F) -> F:
+    """Log the wall-clock time taken by a function call.
+
+    Args:
+        func: The function to wrap.
+
+    Returns:
+        Wrapped function that logs its duration.
+    """
+
+    @functools.wraps(func)
+    def wrapper(*args: Any, **kwargs: Any) -> Any:
+        start = time.perf_counter()
+        result = func(*args, **kwargs)
+        elapsed = time.perf_counter() - start
+        logger.debug("%s completed in %.4f s", func.__qualname__, elapsed)
+        return result
+
+    return wrapper  # type: ignore[return-value]
+
+
+def stable_hash(data: dict[str, Any]) -> str:
+    """Compute a stable SHA-256 hex digest for a JSON-serialisable dict.
+
+    Args:
+        data: Dictionary to hash.
+
+    Returns:
+        Hex digest string.
+    """
+    serialised = json.dumps(data, sort_keys=True, default=str).encode()
+    return hashlib.sha256(serialised).hexdigest()
+
+
+def clamp(value: float, lo: float, hi: float) -> float:
+    """Clamp a float to the closed interval [lo, hi].
+
+    Args:
+        value: The value to clamp.
+        lo: Lower bound.
+        hi: Upper bound.
+
+    Returns:
+        Clamped float.
+    """
+    return max(lo, min(hi, value))
+
+
+def chunk(lst: list[Any], size: int) -> list[list[Any]]:
+    """Split a list into fixed-size chunks.
+
+    Args:
+        lst: List to split.
+        size: Maximum chunk size (must be >= 1).
+
+    Returns:
+        List of sub-lists, each of length at most size.
+
+    Raises:
+        ValueError: If size < 1.
+    """
+    if size < 1:
+        raise ValueError(f"chunk size must be >= 1, got {size}")
+    return [lst[i : i + size] for i in range(0, len(lst), size)]
+
+
+def safe_divide(numerator: float, denominator: float, default: float = 0.0) -> float:
+    """Divide numerator by denominator, returning default on zero division.
+
+    Args:
+        numerator: Dividend.
+        denominator: Divisor.
+        default: Value to return when denominator is zero.
+
+    Returns:
+        Result of division or default.
+    """
+    if denominator == 0.0:
+        return default
+    return numerator / denominator
