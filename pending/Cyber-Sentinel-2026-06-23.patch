From 2d11c9e10119f647fc9f238608d39984ac0f4001 Mon Sep 17 00:00:00 2001
From: Reflective Lantern <devneatharva@gmail.com>
Date: Tue, 23 Jun 2026 10:09:47 +0000
Subject: [PATCH 05/60] feat(5/60): add KS-test drift detection with sliding
 window monitor

---
 app/monitoring.py | 133 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 133 insertions(+)
 create mode 100644 app/monitoring.py

diff --git a/app/monitoring.py b/app/monitoring.py
new file mode 100644
index 0000000..2414507
--- /dev/null
+++ b/app/monitoring.py
@@ -0,0 +1,133 @@
+"""KS-test drift detection and prediction logging."""
+
+import logging
+from collections import deque
+from dataclasses import dataclass, field
+from datetime import datetime
+from typing import Deque
+
+import numpy as np
+from scipy import stats
+
+logger = logging.getLogger(__name__)
+
+DRIFT_THRESHOLD = float(0.05)
+WINDOW_SIZE = int(1000)
+
+
+@dataclass
+class DriftResult:
+    """Result of a KS-test drift check for one feature."""
+
+    feature_name: str
+    ks_statistic: float
+    p_value: float
+    drift_detected: bool
+    checked_at: datetime = field(default_factory=datetime.utcnow)
+
+
+class DriftMonitor:
+    """Sliding-window KS-test monitor for feature distribution drift.
+
+    Maintains a reference window (baseline) and a production window.
+    When the production window fills, it runs KS tests against the baseline.
+    """
+
+    def __init__(
+        self,
+        feature_names: list[str],
+        window_size: int = WINDOW_SIZE,
+        threshold: float = DRIFT_THRESHOLD,
+    ) -> None:
+        """Initialise the monitor.
+
+        Args:
+            feature_names: Names of features to track.
+            window_size: Number of observations per window.
+            threshold: p-value below which drift is flagged.
+        """
+        self.feature_names = feature_names
+        self.window_size = window_size
+        self.threshold = threshold
+        self.reference: dict[str, list[float]] = {f: [] for f in feature_names}
+        self.production: dict[str, Deque[float]] = {
+            f: deque(maxlen=window_size) for f in feature_names
+        }
+        self._drift_history: list[DriftResult] = []
+
+    def set_reference(self, data: dict[str, list[float]]) -> None:
+        """Load baseline distribution from training data statistics.
+
+        Args:
+            data: Mapping of feature name → list of reference values.
+        """
+        for feat in self.feature_names:
+            self.reference[feat] = list(data.get(feat, []))
+        logger.info("Reference distribution set for %d features", len(self.feature_names))
+
+    def observe(self, features: dict[str, float]) -> list[DriftResult] | None:
+        """Record a new observation and trigger drift check when window is full.
+
+        Args:
+            features: Mapping of feature name → observed value.
+
+        Returns:
+            List of DriftResult if the window is full, else None.
+        """
+        for feat in self.feature_names:
+            if feat in features:
+                self.production[feat].append(float(features[feat]))
+
+        if len(self.production[self.feature_names[0]]) >= self.window_size:
+            return self._run_ks_tests()
+        return None
+
+    def _run_ks_tests(self) -> list[DriftResult]:
+        """Run KS tests for all features and return results.
+
+        Returns:
+            List of DriftResult, one per feature.
+        """
+        results: list[DriftResult] = []
+        for feat in self.feature_names:
+            ref = self.reference.get(feat, [])
+            prod = list(self.production[feat])
+            if not ref or not prod:
+                continue
+            ks_stat, p_val = stats.ks_2samp(ref, prod)
+            drift = bool(p_val < self.threshold)
+            result = DriftResult(
+                feature_name=feat,
+                ks_statistic=float(ks_stat),
+                p_value=float(p_val),
+                drift_detected=drift,
+            )
+            self._drift_history.append(result)
+            if drift:
+                logger.warning(
+                    "Drift detected on feature '%s': KS=%.4f p=%.4f",
+                    feat,
+                    ks_stat,
+                    p_val,
+                )
+        return results
+
+    def drift_summary(self) -> dict[str, int]:
+        """Return count of drifted vs clean features in the last check.
+
+        Returns:
+            Dict with keys 'drifted' and 'clean'.
+        """
+        if not self._drift_history:
+            return {"drifted": 0, "clean": 0}
+        last_check = [
+            r for r in self._drift_history
+            if r.checked_at == self._drift_history[-1].checked_at
+        ]
+        drifted = sum(1 for r in last_check if r.drift_detected)
+        return {"drifted": drifted, "clean": len(last_check) - drifted}
+
+    @property
+    def history(self) -> list[DriftResult]:
+        """Return the full drift check history."""
+        return list(self._drift_history)
-- 
