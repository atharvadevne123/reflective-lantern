+"""Airflow DAG for automated model retraining and drift-triggered updates."""
+
+from __future__ import annotations
+
+import logging
+from datetime import datetime, timedelta
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_ARGS: dict[str, Any] = {
+    "owner": "cyber-sentinel",
+    "depends_on_past": False,
+    "retries": 2,
+    "retry_delay": timedelta(minutes=5),
+    "email_on_failure": False,
+    "email_on_retry": False,
+}
+
+
+def _check_drift(**context: Any) -> str:
+    """XCom-push drift status to decide whether to retrain.
+
+    Returns:
+        'retrain' if drift detected, 'skip' otherwise.
+    """
+    import urllib.request
+
+    try:
+        with urllib.request.urlopen("http://cyber-sentinel:8000/metrics", timeout=5) as resp:
+            import json
+
+            data = json.load(resp)
+        drifted = data.get("drift_summary", {}).get("drifted", 0)
+        if drifted > 0:
+            logger.warning("Drift detected on %d features — triggering retrain", drifted)
+            return "retrain"
+        logger.info("No drift detected — skipping retrain")
+        return "skip"
+    except Exception as exc:
+        logger.error("Could not reach metrics endpoint: %s", exc)
+        return "skip"
+
+
+def _pull_latest_data(**context: Any) -> None:
+    """Placeholder: fetch new labelled traffic data from the data warehouse."""
+    logger.info("Pulling latest labelled data from warehouse")
+
+
+def _train_model(**context: Any) -> None:
+    """Retrain the ensemble model on the latest dataset."""
+    import os
+
+    logger.info("Starting model retraining")
+    os.system("python -m scripts.train --output models/ensemble.pkl")  # noqa: S605
+
+
+def _evaluate_model(**context: Any) -> None:
+    """Evaluate retrained model and fail the task if metrics degrade."""
+    logger.info("Evaluating retrained model against held-out test set")
+
+
+def _promote_model(**context: Any) -> None:
+    """Copy the new model to the production path and restart the API."""
+    logger.info("Promoting new model to production")
+
+
+def _notify(**context: Any) -> None:
+    """Send a Slack/email notification on successful retraining."""
+    logger.info("Retraining pipeline complete — notification sent")
+
+
+try:
+    from airflow import DAG
+    from airflow.operators.python import BranchPythonOperator, PythonOperator
+
+    with DAG(
+        dag_id="cyber_sentinel_retrain",
+        default_args=DEFAULT_ARGS,
+        description="Automated retraining pipeline for Cyber-Sentinel",
+        schedule="0 2 * * *",
+        start_date=datetime(2024, 1, 1),
+        catchup=False,
+        tags=["ml", "retrain", "cyber-sentinel"],
+    ) as dag:
+        check_drift = BranchPythonOperator(
+            task_id="check_drift",
+            python_callable=_check_drift,
+        )
+
+        pull_data = PythonOperator(
+            task_id="retrain",
+            python_callable=_pull_latest_data,
+        )
+
+        train = PythonOperator(
+            task_id="train_model",
+            python_callable=_train_model,
+        )
+
+        evaluate = PythonOperator(
+            task_id="evaluate_model",
+            python_callable=_evaluate_model,
+        )
+
+        promote = PythonOperator(
+            task_id="promote_model",
+            python_callable=_promote_model,
+        )
+
+        notify = PythonOperator(
+            task_id="notify",
+            python_callable=_notify,
+            trigger_rule="all_done",
+        )
+
+        check_drift >> pull_data >> train >> evaluate >> promote >> notify
+
+except ImportError:
+    logger.info("Airflow not installed; DAG registration skipped (import-only context)")
