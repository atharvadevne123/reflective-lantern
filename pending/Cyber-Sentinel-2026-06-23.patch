+"""Tests for rate-limiting and structured-logging middleware."""
+
+import time
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from starlette.requests import Request
+from starlette.responses import Response
+
+from app.middleware import RateLimitMiddleware, StructuredLoggingMiddleware
+
+
+def _make_app_with_rate_limit(max_requests: int = 3, window: int = 60) -> FastAPI:
+    app = FastAPI()
+    app.add_middleware(RateLimitMiddleware, max_requests=max_requests, window_seconds=window)
+
+    @app.get("/ping")
+    def ping():
+        return {"ok": True}
+
+    return app
+
+
+def test_rate_limit_allows_requests_under_limit():
+    app = _make_app_with_rate_limit(max_requests=5)
+    client = TestClient(app, raise_server_exceptions=False)
+    for _ in range(3):
+        resp = client.get("/ping")
+        assert resp.status_code == 200
+
+
+def test_rate_limit_blocks_excess_requests():
+    app = _make_app_with_rate_limit(max_requests=2)
+    client = TestClient(app, raise_server_exceptions=False)
+    client.get("/ping")
+    client.get("/ping")
+    resp = client.get("/ping")
+    assert resp.status_code == 429
+
+
+def test_rate_limit_header_present():
+    app = _make_app_with_rate_limit(max_requests=10)
+    client = TestClient(app, raise_server_exceptions=False)
+    resp = client.get("/ping")
+    assert "X-RateLimit-Remaining" in resp.headers
+
+
+def test_structured_logging_adds_correlation_header():
+    app = FastAPI()
+    app.add_middleware(StructuredLoggingMiddleware)
+
+    @app.get("/hi")
+    def hi():
+        return {"hi": True}
+
+    client = TestClient(app)
+    resp = client.get("/hi", headers={"X-Correlation-ID": "abc-123"})
+    assert resp.headers["X-Correlation-ID"] == "abc-123"
+
+
+def test_structured_logging_generates_correlation_id_if_missing():
+    app = FastAPI()
+    app.add_middleware(StructuredLoggingMiddleware)
+
+    @app.get("/hi")
+    def hi():
+        return {"hi": True}
+
