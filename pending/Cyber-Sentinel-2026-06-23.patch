+"""Tests for KS-test drift detection and monitoring."""
+
+import math
+
+import numpy as np
+import pytest
+
+from app.monitoring import DRIFT_THRESHOLD, WINDOW_SIZE, DriftMonitor, DriftResult
+
+
+@pytest.fixture
+def monitor() -> DriftMonitor:
+    features = ["serror_rate", "rerror_rate", "count", "srv_count", "dst_bytes"]
+    m = DriftMonitor(feature_names=features, window_size=50, threshold=0.05)
+    ref = {f: list(np.random.default_rng(0).uniform(0, 1, 200)) for f in features}
+    m.set_reference(ref)
+    return m
+
+
+def test_monitor_initialises_empty_history(monitor: DriftMonitor) -> None:
+    assert monitor.history == []
+
+
+def test_observe_returns_none_before_window_full(monitor: DriftMonitor) -> None:
+    result = monitor.observe({"serror_rate": 0.1, "rerror_rate": 0.0, "count": 5.0,
+                               "srv_count": 5.0, "dst_bytes": 100.0})
+    assert result is None
+
+
+def test_observe_returns_results_when_window_full(monitor: DriftMonitor) -> None:
+    rng = np.random.default_rng(1)
+    for _ in range(50):
+        obs = {
+            "serror_rate": float(rng.uniform(0, 1)),
+            "rerror_rate": float(rng.uniform(0, 1)),
+            "count": float(rng.uniform(0, 100)),
+            "srv_count": float(rng.uniform(0, 100)),
+            "dst_bytes": float(rng.uniform(0, 1000)),
+        }
+        results = monitor.observe(obs)
+    assert results is not None
+    assert len(results) > 0
+
+
+def test_drift_result_has_required_fields(monitor: DriftMonitor) -> None:
+    rng = np.random.default_rng(99)
+    for _ in range(50):
+        monitor.observe({
+            "serror_rate": float(rng.uniform(0, 1)),
+            "rerror_rate": float(rng.uniform(0, 1)),
+            "count": float(rng.uniform(0, 100)),
+            "srv_count": float(rng.uniform(0, 100)),
+            "dst_bytes": float(rng.uniform(0, 1000)),
+        })
+    assert len(monitor.history) > 0
+    result = monitor.history[0]
+    assert isinstance(result, DriftResult)
+    assert hasattr(result, "ks_statistic")
+    assert hasattr(result, "p_value")
+    assert hasattr(result, "drift_detected")
+
+
+def test_drift_detected_on_shifted_distribution(monitor: DriftMonitor) -> None:
+    rng = np.random.default_rng(7)
+    for _ in range(50):
+        monitor.observe({
+            "serror_rate": float(rng.uniform(0.9, 1.0)),
+            "rerror_rate": float(rng.uniform(0.9, 1.0)),
+            "count": float(rng.uniform(900, 1000)),
+            "srv_count": float(rng.uniform(900, 1000)),
+            "dst_bytes": float(rng.uniform(9000, 10000)),
+        })
+    drifted_count = sum(1 for r in monitor.history if r.drift_detected)
+    assert drifted_count > 0
+
+
+def test_no_drift_on_same_distribution(monitor: DriftMonitor) -> None:
+    rng = np.random.default_rng(0)
+    for _ in range(50):
+        monitor.observe({
+            "serror_rate": float(rng.uniform(0, 1)),
+            "rerror_rate": float(rng.uniform(0, 1)),
+            "count": float(rng.uniform(0, 100)),
+            "srv_count": float(rng.uniform(0, 100)),
+            "dst_bytes": float(rng.uniform(0, 1000)),
+        })
+    drifted = [r for r in monitor.history if r.drift_detected]
+    assert len(drifted) == 0
+
+
+def test_drift_summary_returns_dict(monitor: DriftMonitor) -> None:
+    summary = monitor.drift_summary()
+    assert isinstance(summary, dict)
+    assert "drifted" in summary
+    assert "clean" in summary
+
+
+def test_drift_summary_zeros_before_any_check(monitor: DriftMonitor) -> None:
+    summary = monitor.drift_summary()
+    assert summary["drifted"] == 0
+    assert summary["clean"] == 0
+
+
+def test_ks_statistic_between_zero_and_one(monitor: DriftMonitor) -> None:
+    rng = np.random.default_rng(42)
+    for _ in range(50):
+        monitor.observe({
+            "serror_rate": float(rng.uniform(0, 1)),
+            "rerror_rate": float(rng.uniform(0, 1)),
+            "count": float(rng.uniform(0, 100)),
+            "srv_count": float(rng.uniform(0, 100)),
+            "dst_bytes": float(rng.uniform(0, 1000)),
+        })
+    for result in monitor.history:
+        assert 0.0 <= result.ks_statistic <= 1.0
+
+
+@pytest.mark.parametrize("window_size", [10, 50, 100])
+def test_monitor_with_different_window_sizes(window_size: int) -> None:
+    features = ["count"]
+    m = DriftMonitor(feature_names=features, window_size=window_size)
+    ref = {"count": list(np.arange(200, dtype=float))}
+    m.set_reference(ref)
+    rng = np.random.default_rng(5)
+    results = None
+    for _ in range(window_size):
+        results = m.observe({"count": float(rng.uniform(0, 10))})
+    assert results is not None
