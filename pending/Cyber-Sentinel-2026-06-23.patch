+"""Pydantic request and response schemas for the Cyber-Sentinel API."""
+
+from typing import Any
+
+from pydantic import BaseModel, Field, field_validator
+
+
+class NetworkTrafficRequest(BaseModel):
+    """Incoming network traffic feature vector for intrusion detection."""
+
+    duration: float = Field(default=0.0, ge=0, description="Connection duration in seconds")
+    protocol_type: str = Field(default="tcp", description="Network protocol (tcp/udp/icmp)")
+    service: str = Field(default="http", description="Destination network service")
+    flag: str = Field(default="SF", description="Connection status flag")
+    src_bytes: int = Field(default=0, ge=0, description="Bytes sent from source")
+    dst_bytes: int = Field(default=0, ge=0, description="Bytes sent from destination")
+    land: int = Field(default=0, ge=0, le=1, description="1 if source==destination host/port")
+    wrong_fragment: int = Field(default=0, ge=0)
+    urgent: int = Field(default=0, ge=0)
+    hot: int = Field(default=0, ge=0)
+    num_failed_logins: int = Field(default=0, ge=0)
+    logged_in: int = Field(default=0, ge=0, le=1)
+    num_compromised: int = Field(default=0, ge=0)
+    root_shell: int = Field(default=0, ge=0, le=1)
+    su_attempted: int = Field(default=0, ge=0, le=1)
+    num_root: int = Field(default=0, ge=0)
+    num_file_creations: int = Field(default=0, ge=0)
+    num_shells: int = Field(default=0, ge=0)
+    num_access_files: int = Field(default=0, ge=0)
+    num_outbound_cmds: int = Field(default=0, ge=0)
+    is_host_login: int = Field(default=0, ge=0, le=1)
+    is_guest_login: int = Field(default=0, ge=0, le=1)
+    count: int = Field(default=0, ge=0)
+    srv_count: int = Field(default=0, ge=0)
+    serror_rate: float = Field(default=0.0, ge=0.0, le=1.0)
+    srv_serror_rate: float = Field(default=0.0, ge=0.0, le=1.0)
