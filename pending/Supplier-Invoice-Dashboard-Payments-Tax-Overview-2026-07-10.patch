 /invoices/bulk-csv endpoints wiring bulk.py

---
 app/main.py | 75 ++++++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 74 insertions(+), 1 deletion(-)

diff --git a/app/main.py b/app/main.py
index e025250..84a6dc5 100644
--- a/app/main.py
+++ b/app/main.py
@@ -6,7 +6,7 @@ from datetime import date
 from decimal import Decimal
 from typing import Optional
 
-from fastapi import Depends, FastAPI, HTTPException, Query, status
+from fastapi import Body, Depends, FastAPI, HTTPException, Query, status
 from fastapi.middleware.cors import CORSMiddleware
 from sqlalchemy import text
 from sqlalchemy.orm import Session
@@ -23,6 +23,7 @@ from app.analytics import (
     supplier_outstanding_ranking,
     top_currencies_by_invoice_count,
 )
+from app.bulk import BulkImportError, parse_csv_invoices, to_invoice_create_payload
 from app.config import settings
 from app.currency import normalize_to_usd
 from app.database import SupplierInvoice, create_tables, get_db
@@ -35,6 +36,7 @@ from app.reporting import (
     build_view_selector_payload,
 )
 from app.schemas import (
+    BulkImportResponse,
     HealthResponse,
     InvoiceCreate,
     InvoiceResponse,
@@ -477,6 +479,77 @@ def delete_invoice(invoice_number: str, db: Session = Depends(get_db)) -> None:
         raise HTTPException(status_code=500, detail="Failed to delete invoice") from None
 
 
+def _import_invoice_rows(rows: list[dict], db: Session) -> BulkImportResponse:
+    """Validate and persist parsed invoice rows, collecting per-row outcomes.
+
+    Duplicate invoice numbers (already in the DB or repeated within the batch)
+    are skipped; rows failing schema validation are counted as errors.
+    """
+    imported = 0
+    skipped = 0
+    errors: list[str] = []
+    seen_numbers: set[str] = set()
+    for i, row in enumerate(rows, start=1):
+        try:
+            payload = InvoiceCreate(**to_invoice_create_payload(row))
+        except Exception as e:
+            errors.append(f"Row {i}: {e}")
+            continue
+        if payload.invoice_number in seen_numbers:
+            skipped += 1
+            continue
+        existing = (
+            db.query(SupplierInvoice)
+            .filter(SupplierInvoice.invoice_number == payload.invoice_number)
+            .first()
+        )
+        if existing:
+            skipped += 1
+            continue
+        db.add(SupplierInvoice(**payload.model_dump()))
+        seen_numbers.add(payload.invoice_number)
+        imported += 1
+    db.commit()
+    return BulkImportResponse(
+        imported_count=imported,
+        skipped_count=skipped,
+        error_count=len(errors),
+        errors=errors[:50],
+    )
+
+
+@app.post(
+    f"{settings.api_prefix}/invoices/bulk",
+    response_model=BulkImportResponse,
+    status_code=status.HTTP_201_CREATED,
+    tags=["Invoices"],
+)
+def bulk_import_json(payload: list[dict], db: Session = Depends(get_db)) -> BulkImportResponse:
+    """Bulk-import invoices from a JSON array of invoice objects."""
+    if not payload:
+        raise HTTPException(status_code=400, detail="Request list must not be empty")
+    if len(payload) > 1000:
+        raise HTTPException(status_code=400, detail="Batch size must not exceed 1000 rows")
+    return _import_invoice_rows(payload, db)
+
+
+@app.post(
+    f"{settings.api_prefix}/invoices/bulk-csv",
+    response_model=BulkImportResponse,
+    status_code=status.HTTP_201_CREATED,
+    tags=["Invoices"],
+)
+def bulk_import_csv(body: str = Body(..., media_type="text/csv"), db: Session = Depends(get_db)) -> BulkImportResponse:
+    """Bulk-import invoices from a raw CSV body (header row required)."""
+    try:
+        rows = parse_csv_invoices(body)
+    except BulkImportError as e:
+        raise HTTPException(status_code=422, detail=str(e)) from e
+    if not rows:
+        raise HTTPException(status_code=400, detail="CSV contained no data rows")
+    return _import_invoice_rows(rows, db)
+
+
 if __name__ == "__main__":
     import uvicorn
 
-- 
