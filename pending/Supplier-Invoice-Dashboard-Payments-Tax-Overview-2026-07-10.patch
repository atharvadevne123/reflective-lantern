From 5106e6c1c21f8961f42f58bc1ac83782bb9e73ad Mon Sep 17 00:00:00 2001
From: Reflective Lantern <devneatharva@gmail.com>
Date: Sat, 11 Jul 2026 17:27:11 +0000
Subject: [PATCH 54/60] test(54/60): add 3 cache tests (stats shape,
 invalidation, key independence)

---
 tests/test_cache.py | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/tests/test_cache.py b/tests/test_cache.py
index f5b4f8b..bfb25ef 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -141,3 +141,35 @@ def test_get_or_set_different_keys_call_factory_separately() -> None:
     get_or_set("key-a", factory)
     get_or_set("key-b", factory)
     assert call_count == 2
+
+
+def test_cache_stats_returns_dict() -> None:
+    from app.cache import cache_stats
+
+    stats = cache_stats()
+    assert isinstance(stats, dict)
+
+
+def test_invalidate_all_resets_cache() -> None:
+    from app.cache import get_or_set, invalidate_all
+
+    calls = {"n": 0}
+
+    def factory():
+        calls["n"] += 1
+        return calls["n"]
+
+    first = get_or_set("test-invalidation-key", factory, ttl_seconds=300)
+    cached = get_or_set("test-invalidation-key", factory, ttl_seconds=300)
+    assert first == cached  # second call served from cache
+    invalidate_all()
+    fresh = get_or_set("test-invalidation-key", factory, ttl_seconds=300)
+    assert fresh != first  # factory re-invoked after invalidation
+
+
+def test_get_or_set_distinct_keys_independent() -> None:
+    from app.cache import get_or_set
+
+    a = get_or_set("key-a-independent", lambda: "A", ttl_seconds=300)
+    b = get_or_set("key-b-independent", lambda: "B", ttl_seconds=300)
+    assert a == "A" and b == "B"
-- 
