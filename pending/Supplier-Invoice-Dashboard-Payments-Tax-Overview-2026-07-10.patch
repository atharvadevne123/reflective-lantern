Subject: [PATCH 50/60] test(50/60): add 3 middleware tests for X-Response-Time
 and correlation-ID headers

---
 tests/test_middleware.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tests/test_middleware.py b/tests/test_middleware.py
index dff0550..ea205c7 100644
--- a/tests/test_middleware.py
+++ b/tests/test_middleware.py
@@ -28,3 +28,20 @@ def test_correlation_id_unique_per_request(client) -> None:
 def test_correlation_id_present_on_404(client) -> None:
     response = client.get("/api/v1/invoices/NONEXISTENT-INV")
     assert "X-Correlation-ID" in response.headers
+
+
+def test_response_time_header_present(client):
+    resp = client.get("/api/v1/health")
+    assert "x-response-time" in resp.headers
+    assert resp.headers["x-response-time"].endswith("ms")
+
+
+def test_correlation_id_echoed_back(client):
+    resp = client.get("/api/v1/health", headers={"X-Correlation-ID": "my-trace-id"})
+    assert resp.headers.get("x-correlation-id") == "my-trace-id"
+
+
+def test_correlation_id_generated_when_absent(client):
+    resp = client.get("/api/v1/health")
+    cid = resp.headers.get("x-correlation-id")
+    assert cid and len(cid) == 32  # uuid4().hex
