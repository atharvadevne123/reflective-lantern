+@app.put(
+    f"{settings.api_prefix}/invoices/{{invoice_number}}/payment",
+    response_model=InvoiceResponse,
+    tags=["Invoices"],
+)
+def update_invoice_body(
+    invoice_number: str,
+    payload: InvoiceUpdate,
+    db: Session = Depends(get_db),
+) -> InvoiceResponse:
+    """Update payment fields of an invoice from a JSON body (InvoiceUpdate schema)."""
+    inv = db.query(SupplierInvoice).filter(SupplierInvoice.invoice_number == invoice_number).first()
+    if not inv:
+        raise HTTPException(status_code=404, detail=f"Invoice {invoice_number} not found")
+    if payload.amount_paid is not None and payload.amount_paid > inv.invoice_amount:
+        raise HTTPException(status_code=422, detail="amount_paid cannot exceed invoice_amount")
+    try:
+        if payload.amount_paid is not None:
+            inv.amount_paid = payload.amount_paid
+        if payload.payment_status is not None:
+            inv.payment_status = payload.payment_status.value
+        db.commit()
+        db.refresh(inv)
+    except Exception:
+        db.rollback()
+        logger.exception("Failed to update invoice %s", invoice_number)
+        raise HTTPException(status_code=500, detail="Failed to update invoice") from None
+    return _to_response(inv)
+
+
