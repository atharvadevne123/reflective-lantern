From 88d33b742cda744a382f3cf3c2fa781ab7b3cc10 Mon Sep 17 00:00:00 2001
From: Reflective Lantern <devneatharva@gmail.com>
Date: Sat, 11 Jul 2026 17:27:58 +0000
Subject: [PATCH 55/60] feat(55/60): add argparse --count/--force flags to
 sample data seeder

---
 scripts/generate_sample_data.py | 29 +++++++++++++++++++++++------
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/scripts/generate_sample_data.py b/scripts/generate_sample_data.py
index aead890..564c142 100644
--- a/scripts/generate_sample_data.py
+++ b/scripts/generate_sample_data.py
@@ -1,5 +1,6 @@
 """Seed the database with realistic supplier invoice sample data."""
 
+import argparse
 import logging
 import os
 import random
@@ -74,21 +75,27 @@ def _random_invoice(index: int) -> SupplierInvoice:
     )
 
 
-def seed(count: int = 100) -> None:
+def seed(count: int = 100, force: bool = False) -> None:
     """Insert ``count`` sample invoices into the database.
 
-    Skips seeding if the database already contains any records.
+    Skips seeding if the database already contains records, unless force=True,
+    in which case existing rows are deleted first.
 
     Args:
         count: Number of sample invoices to insert (default 100).
+        force: Delete existing invoices and reseed when True.
     """
     create_tables()
     db: Session = SessionLocal()
     try:
         existing = db.query(SupplierInvoice).count()
         if existing > 0:
-            logger.info("Database already contains %d invoices — skipping seed", existing)
-            return
+            if not force:
+                logger.info("Database already contains %d invoices — skipping seed", existing)
+                return
+            db.query(SupplierInvoice).delete()
+            db.commit()
+            logger.info("Force mode: deleted %d existing invoices", existing)
         invoices = [_random_invoice(i) for i in range(1, count + 1)]
         db.add_all(invoices)
         db.commit()
@@ -101,6 +108,16 @@ def seed(count: int = 100) -> None:
         db.close()
 
 
+def _parse_args() -> "argparse.Namespace":
+    """Parse CLI arguments for the seeding script."""
+    parser = argparse.ArgumentParser(description="Seed sample supplier invoices")
+    parser.add_argument("--count", type=int, default=100, help="Number of invoices to insert")
+    parser.add_argument(
+        "--force", action="store_true", help="Delete existing invoices and reseed"
+    )
+    return parser.parse_args()
+
+
 if __name__ == "__main__":
-    count = int(sys.argv[1]) if len(sys.argv) > 1 else 100
-    seed(count)
+    args = _parse_args()
+    seed(count=args.count, force=args.force)
