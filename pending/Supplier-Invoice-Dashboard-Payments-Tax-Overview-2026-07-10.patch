+"""Smoke tests for CLI scripts: importability and argument parsing."""
+
+import os
+import sys
+
+SCRIPTS_DIR = os.path.join(os.path.dirname(os.path.dirname(__file__)), "scripts")
+if SCRIPTS_DIR not in sys.path:
+    sys.path.insert(0, SCRIPTS_DIR)
+
+
+def test_generate_sample_data_importable():
+    import generate_sample_data
+
+    assert callable(generate_sample_data.seed)
+
+
+def test_generate_sample_data_random_invoice_shape():
+    import generate_sample_data
+
+    inv = generate_sample_data._random_invoice(1)
+    assert inv.invoice_number
+    assert inv.invoice_amount > 0
+    assert inv.currency in generate_sample_data.CURRENCIES
+
+
+def test_generate_sample_data_parse_args_defaults(monkeypatch):
+    import generate_sample_data
+
+    monkeypatch.setattr(sys, "argv", ["generate_sample_data.py"])
+    args = generate_sample_data._parse_args()
+    assert args.count == 100
+    assert args.force is False
+
+
+def test_generate_sample_data_parse_args_custom(monkeypatch):
+    import generate_sample_data
+
+    monkeypatch.setattr(sys, "argv", ["generate_sample_data.py", "--count", "5", "--force"])
+    args = generate_sample_data._parse_args()
+    assert args.count == 5
+    assert args.force is True
+
+
+def test_analytics_dashboard_importable():
+    import analytics_dashboard
+
+    assert callable(analytics_dashboard.run_dashboard)
+
+
+def test_export_report_importable():
+    import export_report
+
+    assert hasattr(export_report, "__doc__")
