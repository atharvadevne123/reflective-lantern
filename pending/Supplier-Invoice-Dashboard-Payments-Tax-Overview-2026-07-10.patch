+"""Unit tests for invoice_size_distribution and supplier_payment_performance."""
+
+from datetime import date
+from decimal import Decimal
+
+from app.analytics import invoice_size_distribution, supplier_payment_performance
+
+
+def _inv(supplier: str, amount: str, status: str = "UNPAID") -> dict:
+    return {
+        "invoice_number": f"T-{supplier}-{amount}",
+        "supplier": supplier,
+        "invoice_amount": Decimal(amount),
+        "amount_paid": Decimal("0"),
+        "payment_status": status,
+        "invoice_date": date(2025, 1, 1),
+        "currency": "USD",
+        "business_unit": "BU",
+    }
+
+
+def test_size_distribution_buckets():
+    invoices = [_inv("A", "500"), _inv("B", "5000"), _inv("C", "50000")]
+    dist = invoice_size_distribution(invoices)
+    assert dist["small"]["count"] == 1
+    assert dist["medium"]["count"] == 1
+    assert dist["large"]["count"] == 1
+
+
+def test_size_distribution_totals():
+    invoices = [_inv("A", "100"), _inv("B", "200")]
+    dist = invoice_size_distribution(invoices)
+    assert dist["small"]["total_amount"] == Decimal("300")
+    assert dist["medium"]["count"] == 0
+
+
+def test_size_distribution_empty():
+    dist = invoice_size_distribution([])
+    assert dist["small"]["count"] == 0
+    assert dist["large"]["total_amount"] == Decimal("0")
+
+
+def test_size_distribution_boundary_1000_is_medium():
+    dist = invoice_size_distribution([_inv("A", "1000")])
+    assert dist["medium"]["count"] == 1
+
+
+def test_size_distribution_boundary_10000_is_large():
+    dist = invoice_size_distribution([_inv("A", "10000")])
+    assert dist["large"]["count"] == 1
+
+
+def test_payment_performance_ranking():
+    invoices = [
+        _inv("Good Co", "100", "PAID"),
+        _inv("Good Co", "200", "PAID"),
+        _inv("Bad Co", "100", "UNPAID"),
+        _inv("Bad Co", "200", "PAID"),
+    ]
+    perf = supplier_payment_performance(invoices)
+    assert perf[0]["supplier"] == "Good Co"
+    assert perf[0]["paid_ratio"] == 1.0
+    assert perf[1]["supplier"] == "Bad Co"
+    assert perf[1]["paid_ratio"] == 0.5
+
+
