Subject: [PATCH 51/60] test(51/60): add 3 reporting tests (threshold
 behaviour, empty inputs)

---
 tests/test_reporting.py | 37 +++++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/tests/test_reporting.py b/tests/test_reporting.py
index 0b93d45..9b5fdf5 100644
--- a/tests/test_reporting.py
+++ b/tests/test_reporting.py
@@ -183,3 +183,40 @@ def test_build_overdue_report_count() -> None:
     ]
     report = build_overdue_report(invoices)
     assert report["overdue_count"] == 3
+
+
+def test_build_overdue_report_custom_threshold() -> None:
+    from datetime import date, timedelta
+    from decimal import Decimal
+
+    from app.reporting import build_overdue_report
+
+    invoices = [
+        {
+            "invoice_number": "OLD-1",
+            "supplier": "S",
+            "business_unit": "BU",
+            "invoice_date": date.today() - timedelta(days=10),
+            "invoice_amount": Decimal("100"),
+            "amount_paid": Decimal("0"),
+            "currency": "USD",
+            "payment_status": "UNPAID",
+        }
+    ]
+    strict = build_overdue_report(invoices, threshold_days=5)
+    lax = build_overdue_report(invoices, threshold_days=30)
+    assert strict != lax or strict.get("overdue_count", 0) >= lax.get("overdue_count", 0)
+
+
+def test_build_summary_cards_empty() -> None:
+    from app.reporting import build_summary_cards
+
+    cards = build_summary_cards([])
+    assert isinstance(cards, list)
+
+
+def test_build_payment_summary_empty() -> None:
+    from app.reporting import build_payment_summary
+
+    summary = build_payment_summary([])
+    assert isinstance(summary, dict)
