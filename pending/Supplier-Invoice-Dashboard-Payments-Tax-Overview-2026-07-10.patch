                 overdue.append({**inv, "age_days": age_days})
     overdue.sort(key=lambda x: x["age_days"], reverse=True)
     return overdue
+
+
+def invoice_size_distribution(invoices: list[dict]) -> dict[str, dict]:
+    """Bucket invoices into small/medium/large size classes with counts and totals.
+
+    Args:
+        invoices: List of invoice dicts with invoice_amount.
+
+    Returns:
+        Dict keyed by size class, each with count and total_amount fields.
+    """
+    buckets: dict[str, dict] = {
+        size: {"count": 0, "total_amount": Decimal("0")} for size in ("small", "medium", "large")
+    }
+    for inv in invoices:
+        size = classify_invoice_size(inv["invoice_amount"])
+        buckets[size]["count"] += 1
+        buckets[size]["total_amount"] += inv["invoice_amount"]
+    return buckets
+
+
+def supplier_payment_performance(invoices: list[dict]) -> list[dict]:
+    """Score each supplier by the fraction of their invoices fully paid.
+
+    Args:
+        invoices: List of invoice dicts with supplier and payment_status.
+
+    Returns:
+        List of dicts with supplier, total_invoices, paid_invoices, paid_ratio,
+        sorted by paid_ratio descending then supplier name.
+    """
+    counts: dict[str, dict] = defaultdict(lambda: {"total": 0, "paid": 0})
+    for inv in invoices:
+        supplier = inv.get("supplier", "Unknown")
+        counts[supplier]["total"] += 1
+        if inv.get("payment_status") == "PAID":
+            counts[supplier]["paid"] += 1
+    result = [
+        {
+            "supplier": supplier,
+            "total_invoices": c["total"],
+            "paid_invoices": c["paid"],
+            "paid_ratio": round(c["paid"] / c["total"], 4) if c["total"] else 0.0,
+        }
+        for supplier, c in counts.items()
+    ]
+    result.sort(key=lambda x: (-x["paid_ratio"], x["supplier"]))
+    return result
-- 
