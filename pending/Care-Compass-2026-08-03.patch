     }
 
 
+def compute_psi(reference: list, current: list, bins: int = 10) -> dict:
+    """Population Stability Index between two score distributions.
+
+    PSI complements the KS test: it is threshold-based rather than
+    significance-based, so it stays interpretable as sample sizes grow.
+
+    Args:
+        reference: Baseline score distribution.
+        current: Recently served scores.
+        bins: Number of quantile buckets.
+
+    Returns:
+        A dict with the PSI value and a severity band of ``stable``,
+        ``moderate`` or ``significant``.
+    """
+    if len(reference) < 2 or len(current) < 2:
+        return {"psi": 0.0, "severity": "stable", "insufficient_data": True}
+
+    ref = np.asarray(reference, dtype=float)
+    cur = np.asarray(current, dtype=float)
+    edges = np.unique(np.quantile(ref, np.linspace(0, 1, bins + 1)))
+    if len(edges) < 3:
+        return {"psi": 0.0, "severity": "stable", "insufficient_data": True}
+
+    eps = 1e-6
+    ref_pct = np.histogram(ref, bins=edges)[0] / len(ref)
+    cur_pct = np.histogram(cur, bins=edges)[0] / len(cur)
+    ref_pct = np.clip(ref_pct, eps, None)
+    cur_pct = np.clip(cur_pct, eps, None)
+    psi = float(np.sum((cur_pct - ref_pct) * np.log(cur_pct / ref_pct)))
+
+    if psi >= PSI_ALERT_THRESHOLD:
+        severity = "significant"
+    elif psi >= PSI_WARN_THRESHOLD:
+        severity = "moderate"
+    else:
+        severity = "stable"
+    return {"psi": round(psi, 4), "severity": severity, "insufficient_data": False}
+
