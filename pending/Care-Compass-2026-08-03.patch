@@ -8,6 +8,19 @@ from contextvars import ContextVar
 correlation_id: ContextVar[str] = ContextVar("correlation_id", default="-")
 
 
+class CorrelationIdFilter(logging.Filter):
+    """Stamp the active correlation ID onto every record as it is created.
+
+    Binding at creation rather than at format time keeps the ID correct even
+    when a handler formats the record later, off the originating context.
+    """
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        if not hasattr(record, "correlation_id"):
+            record.correlation_id = correlation_id.get()
+        return True
+
+
 class JsonFormatter(logging.Formatter):
     """Render log records as single-line JSON objects."""
 
@@ -17,7 +30,7 @@ class JsonFormatter(logging.Formatter):
             "level": record.levelname,
