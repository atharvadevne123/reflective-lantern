 1 file changed, 95 insertions(+)
 create mode 100644 app/monitoring.py

diff --git a/app/monitoring.py b/app/monitoring.py
new file mode 100644
index 0000000..543a34c
--- /dev/null
+++ b/app/monitoring.py
@@ -0,0 +1,95 @@
+"""Drift detection and prediction logging for model monitoring."""
+
+from datetime import datetime, timedelta, timezone
+
+from scipy.stats import ks_2samp
+from sqlalchemy.orm import Session
+
+from app.database import DriftReport, PredictionLog
+
+DRIFT_P_THRESHOLD = 0.05
+MIN_SAMPLES_FOR_DRIFT = 30
+
+
+def compute_drift(reference: list, current: list) -> dict:
+    """Two-sample KS test between reference and current distributions."""
+    if len(reference) < 2 or len(current) < 2:
+        return {
+            "ks_statistic": 0.0,
+            "p_value": 1.0,
+            "drift_detected": False,
+            "insufficient_data": True,
+        }
+    stat, p = ks_2samp(reference, current)
+    return {
+        "ks_statistic": round(float(stat), 4),
+        "p_value": round(float(p), 4),
+        "drift_detected": bool(p < DRIFT_P_THRESHOLD),
+        "insufficient_data": False,
+    }
+
+
+def log_prediction(
+    db: Session,
+    patient_ref: str,
+    risk_score: float,
+    risk_label: bool,
+    model_version: str,
+    latency_ms: float | None = None,
+) -> PredictionLog:
+    """Persist a served prediction for auditing and drift analysis."""
+    row = PredictionLog(
+        patient_ref=patient_ref,
+        risk_score=risk_score,
+        risk_label=risk_label,
+        model_version=model_version,
+        latency_ms=latency_ms,
+    )
+    db.add(row)
+    db.commit()
+    db.refresh(row)
+    return row
+
+
+def recent_scores(db: Session, hours: int = 24) -> list:
+    """Fetch risk scores logged within the trailing window."""
+    cutoff = datetime.now(timezone.utc) - timedelta(hours=hours)
+    rows = (
+        db.query(PredictionLog.risk_score)
+        .filter(PredictionLog.created_at >= cutoff)
+        .all()
+    )
+    return [r[0] for r in rows]
+
+
+def run_drift_check(db: Session, reference: list, hours: int = 24) -> dict:
+    """Compare recent live scores against the reference distribution.
+
+    Persists a DriftReport row when enough live samples exist.
+    """
+    current = recent_scores(db, hours=hours)
+    result = compute_drift(reference, current)
+    result["n_current"] = len(current)
+    result["n_reference"] = len(reference)
+    if len(current) >= MIN_SAMPLES_FOR_DRIFT and not result.get("insufficient_data"):
+        report = DriftReport(
+            feature_name="risk_score",
+            ks_statistic=result["ks_statistic"],
+            p_value=result["p_value"],
+            drift_detected=result["drift_detected"],
+            sample_size=len(current),
+        )
+        db.add(report)
+        db.commit()
+    return result
+
+
+def prediction_stats(db: Session) -> dict:
+    """Aggregate serving statistics for the /metrics endpoint."""
+    total = db.query(PredictionLog).count()
+    positives = db.query(PredictionLog).filter(PredictionLog.risk_label.is_(True)).count()
+    return {
+        "total_predictions": total,
+        "high_risk_predictions": positives,
+        "high_risk_rate": round(positives / total, 4) if total else 0.0,
+    }
-- 
