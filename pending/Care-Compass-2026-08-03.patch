+"""Automated weekly retraining pipeline.
+
+Defined as an Airflow DAG when Airflow is installed; every task is a plain
+function so the pipeline can also be run directly:
+
+    python -m pipelines.retrain_dag
+"""
+
+import json
+from datetime import datetime, timedelta, timezone
+
+from app.features import generate_synthetic_encounters
+from app.model import MODEL_PATH, load_metrics, train_model
+
+AUC_REGRESSION_TOLERANCE = 0.02
+
+
+def extract_training_data():
+    """Pull the latest labelled encounter cohort (synthetic in dev)."""
+    seed = int(datetime.now(timezone.utc).timestamp()) % 10_000
+    return generate_synthetic_encounters(n=3000, seed=seed)
+
+
+def validate_data(df) -> dict:
+    """Reject cohorts that are too small or label-degenerate."""
+    checks = {
+        "row_count_ok": len(df) >= 500,
+        "label_balance_ok": 0.02 < df["readmitted_30d"].mean() < 0.98,
+        "no_nulls": not df.isnull().any().any(),
+    }
+    if not all(checks.values()):
+        raise ValueError(f"Data validation failed: {checks}")
+    return checks
+
+
+def retrain(df) -> dict:
+    """Retrain, guarding against AUC regression versus the current model."""
+    previous = load_metrics()
+    _, metrics = train_model(df, save=False)
+    prev_auc = previous.get("auc_mean", 0.0)
+    if metrics["auc_mean"] < prev_auc - AUC_REGRESSION_TOLERANCE:
+        raise ValueError(
+            f"Refusing to promote: AUC {metrics['auc_mean']:.4f} regressed "
+            f"beyond tolerance from {prev_auc:.4f}"
+        )
+    _, metrics = train_model(df, save=True)
+    return metrics
+
+
+def publish_report(metrics: dict) -> str:
+    """Write the retrain summary next to the model artifact."""
+    report = {
+        "retrained_at": datetime.now(timezone.utc).isoformat(),
+        "model_path": MODEL_PATH,
+        "metrics": metrics,
+    }
+    path = "retrain_report.json"
+    with open(path, "w") as f:
+        json.dump(report, f, indent=2)
+    return path
+
+
+def run_pipeline() -> dict:
+    """Execute extract -> validate -> retrain -> publish sequentially."""
+    df = extract_training_data()
+    validate_data(df)
+    metrics = retrain(df)
+    publish_report(metrics)
+    return metrics
+
+
+try:  # pragma: no cover - exercised only where Airflow is installed
+    from airflow import DAG
+    from airflow.operators.python import PythonOperator
+
+    with DAG(
+        dag_id="care_compass_retrain",
+        schedule="0 3 * * 0",
+        start_date=datetime(2026, 1, 1, tzinfo=timezone.utc),
+        catchup=False,
+        default_args={"retries": 1, "retry_delay": timedelta(minutes=10)},
+        tags=["ml", "retraining"],
+    ) as dag:
+        t_extract = PythonOperator(task_id="extract", python_callable=extract_training_data)
+        t_run = PythonOperator(task_id="retrain_and_publish", python_callable=run_pipeline)
+        t_extract >> t_run
+except ImportError:  # Airflow not installed: module stays importable
+    dag = None
+
+
+if __name__ == "__main__":
+    print(json.dumps(run_pipeline(), indent=2))
-- 
