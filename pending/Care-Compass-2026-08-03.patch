+"""Render the system architecture diagram to screenshots/architecture.png."""
+
+import os
+
+import matplotlib.patches as mpatches
+import matplotlib.pyplot as plt
+
+
+def box(ax, x, y, w, h, label, color):
+    ax.add_patch(
+        mpatches.FancyBboxPatch(
+            (x, y), w, h, boxstyle="round,pad=0.08", facecolor=color, edgecolor="#333"
+        )
+    )
+    ax.text(x + w / 2, y + h / 2, label, ha="center", va="center", fontsize=10, wrap=True)
+
+
+def arrow(ax, x1, y1, x2, y2, label=""):
+    ax.annotate(
+        "",
+        xy=(x2, y2),
+        xytext=(x1, y1),
+        arrowprops={"arrowstyle": "->", "lw": 1.6, "color": "#444"},
+    )
+    if label:
+        ax.text((x1 + x2) / 2, (y1 + y2) / 2 + 0.12, label, ha="center", fontsize=8, color="#444")
+
+
+def main() -> None:
+    os.makedirs("screenshots", exist_ok=True)
+    fig, ax = plt.subplots(figsize=(14, 7))
+    ax.set_xlim(0, 14)
+    ax.set_ylim(0, 7)
+    ax.axis("off")
+    plt.title("Care-Compass - System Architecture", fontsize=14, fontweight="bold")
+
+    box(ax, 0.4, 4.6, 2.4, 1.2, "EHR client /\nhospital system", "#dbe9f6")
+    box(ax, 3.6, 4.6, 2.8, 1.2, "FastAPI\n/predict /health\n/metrics /drift", "#d5ecd4")
+    box(ax, 7.4, 5.4, 2.8, 1.0, "Feature pipeline\nlag / rolling / ratios", "#fff2cc")
+    box(ax, 7.4, 3.9, 2.8, 1.0, "XGBoost pipeline\n(StandardScaler + XGB)", "#fff2cc")
+    box(ax, 11.0, 4.4, 2.5, 1.4, "Model artifact\nmodel.joblib +\nmetrics.json", "#ead1dc")
+    box(ax, 3.6, 2.2, 2.8, 1.2, "Monitoring\nKS-test drift +\nprediction logs", "#f9d5c8")
+    box(ax, 7.4, 2.2, 2.8, 1.2, "PostgreSQL /\nSQLite (dev)", "#d0e0e3")
+    box(ax, 11.0, 2.2, 2.5, 1.2, "Retraining DAG\nweekly, AUC-guarded", "#d9d2e9")
+
+    arrow(ax, 2.8, 5.2, 3.6, 5.2, "JSON")
