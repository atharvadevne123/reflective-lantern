 1 file changed, 98 insertions(+)
 create mode 100644 app/model.py

diff --git a/app/model.py b/app/model.py
new file mode 100644
index 0000000..1b87ab6
--- /dev/null
+++ b/app/model.py
@@ -0,0 +1,98 @@
+"""Model training, persistence and prediction for readmission risk."""
+
+import json
+import os
+
+import joblib
+import pandas as pd
+from sklearn.model_selection import StratifiedKFold, cross_val_score
+from sklearn.pipeline import Pipeline
+from sklearn.preprocessing import StandardScaler
+from xgboost import XGBClassifier
+
+from app.features import build_features, feature_names, generate_synthetic_encounters
+
+MODEL_PATH = os.getenv("MODEL_PATH", "model.joblib")
+METRICS_PATH = os.getenv("METRICS_PATH", "metrics.json")
+RISK_THRESHOLD = float(os.getenv("RISK_THRESHOLD", "0.5"))
+
+
+def build_pipeline() -> Pipeline:
+    """Assemble the scaler + XGBoost classification pipeline."""
+    return Pipeline(
+        [
+            ("scaler", StandardScaler()),
+            (
+                "model",
+                XGBClassifier(
+                    n_estimators=200,
+                    max_depth=4,
+                    learning_rate=0.08,
+                    subsample=0.9,
+                    colsample_bytree=0.9,
+                    eval_metric="logloss",
+                    n_jobs=2,
+                ),
+            ),
+        ]
+    )
+
+
+def train_model(df: pd.DataFrame | None = None, save: bool = True):
+    """Train the readmission model with 5-fold stratified CV AUC-ROC.
+
+    Returns the fitted pipeline and a metrics dict. When ``save`` is true
+    the pipeline and metrics are persisted to MODEL_PATH / METRICS_PATH.
+    """
+    if df is None:
+        df = generate_synthetic_encounters()
+    feats = build_features(df.drop(columns=["readmitted_30d"]))
+    X = feats[feature_names()]
+    y = df["readmitted_30d"]
+
+    pipe = build_pipeline()
+    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=7)
+    scores = cross_val_score(pipe, X, y, cv=cv, scoring="roc_auc")
+    pipe.fit(X, y)
+
+    metrics = {
+        "auc_mean": float(scores.mean()),
+        "auc_std": float(scores.std()),
+        "n_samples": int(len(X)),
+        "n_features": int(X.shape[1]),
+        "positive_rate": float(y.mean()),
+    }
+    if save:
+        joblib.dump(pipe, MODEL_PATH)
+        with open(METRICS_PATH, "w") as f:
+            json.dump(metrics, f, indent=2)
+    return pipe, metrics
+
+
+def load_model():
+    """Load the persisted pipeline, training one if none exists."""
+    if os.path.exists(MODEL_PATH):
+        return joblib.load(MODEL_PATH)
+    pipe, _ = train_model()
+    return pipe
+
+
+def load_metrics() -> dict:
+    """Load persisted training metrics, or an empty dict when missing."""
+    if os.path.exists(METRICS_PATH):
+        with open(METRICS_PATH) as f:
+            return json.load(f)
+    return {}
+
+
+def predict_risk(pipe: Pipeline, records: pd.DataFrame) -> pd.DataFrame:
+    """Score raw encounter records; returns risk_score and risk_label columns."""
+    feats = build_features(records)
+    X = feats[feature_names()]
+    proba = pipe.predict_proba(X)[:, 1]
+    return pd.DataFrame(
+        {
+            "risk_score": proba,
+            "risk_label": (proba >= RISK_THRESHOLD).astype(bool),
+        }
+    )
-- 
