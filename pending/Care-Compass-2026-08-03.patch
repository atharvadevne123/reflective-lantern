index 0000000..a4916f0
--- /dev/null
+++ b/app/main.py
@@ -0,0 +1,117 @@
+"""Care-Compass FastAPI service: readmission risk scoring endpoints."""
+
+import time
+from contextlib import asynccontextmanager
+
+import pandas as pd
+from fastapi import Depends, FastAPI, HTTPException
+from pydantic import BaseModel, Field
+from sqlalchemy.orm import Session
+
+from app import __version__
+from app.database import get_db, init_db
+from app.features import ADMISSION_TYPES, DISCHARGE_DISPOSITIONS
+from app.model import load_metrics, load_model, predict_risk
+from app.monitoring import log_prediction, prediction_stats, run_drift_check
+
+state: dict = {}
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI):
+    init_db()
+    state["model"] = load_model()
+    state["metrics"] = load_metrics()
+    state["reference_scores"] = []
+    yield
+    state.clear()
+
+
+app = FastAPI(title="Care-Compass", version=__version__, lifespan=lifespan)
+
+
+class EncounterIn(BaseModel):
+    """A raw patient encounter to score for 30-day readmission risk."""
+
+    patient_ref: str = Field(min_length=1, max_length=64)
+    age: int = Field(ge=0, le=120)
+    num_diagnoses: int = Field(ge=1, le=50)
+    num_medications: int = Field(ge=0, le=100)
+    num_lab_procedures: int = Field(ge=0, le=500)
+    length_of_stay: int = Field(ge=1, le=365)
+    prior_admissions_1y: int = Field(ge=0, le=100)
+    days_since_last_discharge: int = Field(ge=0, le=3650)
+    avg_heart_rate: float = Field(ge=20, le=250)
+    avg_systolic_bp: float = Field(ge=50, le=300)
+    avg_glucose: float = Field(ge=20, le=1000)
+    admission_type: str
+    discharge_disposition: str
+
+
+class PredictionOut(BaseModel):
+    """Risk score response for a single encounter."""
+
+    patient_ref: str
+    risk_score: float
+    risk_label: bool
+    model_version: str
+
+
+def _validate_categories(enc: EncounterIn) -> None:
+    if enc.admission_type not in ADMISSION_TYPES:
+        raise HTTPException(422, f"admission_type must be one of {ADMISSION_TYPES}")
+    if enc.discharge_disposition not in DISCHARGE_DISPOSITIONS:
+        raise HTTPException(
+            422, f"discharge_disposition must be one of {DISCHARGE_DISPOSITIONS}"
+        )
+
+
+@app.post("/predict", response_model=PredictionOut)
+def predict(enc: EncounterIn, db: Session = Depends(get_db)):
+    """Score one encounter and log the prediction."""
+    _validate_categories(enc)
+    start = time.perf_counter()
+    record = pd.DataFrame([enc.model_dump(exclude={"patient_ref"})])
+    result = predict_risk(state["model"], record).iloc[0]
+    latency_ms = (time.perf_counter() - start) * 1000.0
+    log_prediction(
+        db,
+        patient_ref=enc.patient_ref,
+        risk_score=float(result["risk_score"]),
+        risk_label=bool(result["risk_label"]),
+        model_version=__version__,
+        latency_ms=latency_ms,
+    )
+    return PredictionOut(
+        patient_ref=enc.patient_ref,
+        risk_score=round(float(result["risk_score"]), 4),
+        risk_label=bool(result["risk_label"]),
+        model_version=__version__,
+    )
+
+
+@app.get("/health")
+def health():
+    """Liveness probe: model loaded and service responsive."""
+    return {
+        "status": "ok",
+        "model_loaded": "model" in state and state["model"] is not None,
+        "version": __version__,
+    }
+
+
+@app.get("/metrics")
+def metrics(db: Session = Depends(get_db)):
+    """Training metrics plus live serving statistics."""
+    return {
+        "training": state.get("metrics", {}),
+        "serving": prediction_stats(db),
+        "version": __version__,
+    }
+
+
+@app.get("/drift")
+def drift(hours: int = 24, db: Session = Depends(get_db)):
+    """KS-test drift check of recent scores against the reference set."""
+    reference = state.get("reference_scores") or []
+    return run_drift_check(db, reference, hours=hours)
-- 
