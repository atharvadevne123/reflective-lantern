         }
         if record.exc_info:
             payload["exception"] = self.formatException(record.exc_info)
@@ -27,16 +40,46 @@ class JsonFormatter(logging.Formatter):
 
 
 def configure_logging(level: str = "INFO") -> None:
-    """Install the JSON formatter on the root logger exactly once."""
+    """Install the JSON formatter and correlation filter on the root logger.
+
+    Idempotent: repeated calls adjust the level without stacking handlers.
+    The correlation filter is attached to the root logger so every record
+    carries an ID, whichever handler ends up emitting it.
+
+    Args:
+        level: Root log level name, e.g. ``INFO`` or ``DEBUG``.
+    """
     root = logging.getLogger()
-    if any(isinstance(h.formatter, JsonFormatter) for h in root.handlers):
-        return
-    handler = logging.StreamHandler(sys.stdout)
-    handler.setFormatter(JsonFormatter())
-    root.handlers = [handler]
+    if not any(isinstance(f, CorrelationIdFilter) for f in root.filters):
+        root.addFilter(CorrelationIdFilter())
+    if not any(isinstance(h.formatter, JsonFormatter) for h in root.handlers):
+        handler = logging.StreamHandler(sys.stdout)
+        handler.setFormatter(JsonFormatter())
+        handler.addFilter(CorrelationIdFilter())
+        root.handlers = [handler]
     root.setLevel(level.upper())
 
 
+class _CorrelationAdapter(logging.LoggerAdapter):
+    """Adapter that binds the active correlation ID at call time."""
+
+    def process(self, msg, kwargs):
+        extra = dict(kwargs.get("extra") or {})
+        extra.setdefault("correlation_id", correlation_id.get())
+        kwargs["extra"] = extra
+        return msg, kwargs
+
+
 def get_logger(name: str) -> logging.LoggerAdapter:
-    """Return a logger that accepts structured ``extra_fields``."""
-    return logging.LoggerAdapter(logging.getLogger(name), {})
