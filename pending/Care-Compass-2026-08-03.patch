+"""Drift detection and prediction logging tests."""
+
+import numpy as np
+
+from app.monitoring import compute_drift, log_prediction, prediction_stats
+
+
+def test_no_drift_same_distribution():
+    rng = np.random.default_rng(0)
+    ref = rng.normal(0.4, 0.1, 500).tolist()
+    cur = rng.normal(0.4, 0.1, 500).tolist()
+    result = compute_drift(ref, cur)
+    assert result["drift_detected"] is False
+
+
+def test_drift_detected_on_shift():
+    rng = np.random.default_rng(1)
+    ref = rng.normal(0.3, 0.05, 500).tolist()
+    cur = rng.normal(0.7, 0.05, 500).tolist()
+    result = compute_drift(ref, cur)
+    assert result["drift_detected"] is True
+    assert result["ks_statistic"] > 0.5
+
+
+def test_drift_insufficient_data():
+    result = compute_drift([0.5], [])
+    assert result["insufficient_data"] is True
+    assert result["drift_detected"] is False
+
+
+def test_log_prediction_persists(db_session):
+    row = log_prediction(db_session, "PT-9", 0.72, True, "0.1.0", latency_ms=12.5)
+    assert row.id is not None
+    stats = prediction_stats(db_session)
+    assert stats["total_predictions"] == 1
+    assert stats["high_risk_predictions"] == 1
+
+
+def test_prediction_stats_empty(db_session):
+    stats = prediction_stats(db_session)
+    assert stats == {
+        "total_predictions": 0,
+        "high_risk_predictions": 0,
+        "high_risk_rate": 0.0,
+    }
