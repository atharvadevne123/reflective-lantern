+"""Correlation-ID and rate-limiting middleware tests."""
+
+import json
+import logging
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from app.logging_config import JsonFormatter, configure_logging, correlation_id
+from app.middleware import CorrelationIdMiddleware, RateLimitMiddleware
+
+
+def _app(limit: int = 3) -> FastAPI:
+    application = FastAPI()
+    application.add_middleware(RateLimitMiddleware, limit_per_minute=limit)
+    application.add_middleware(CorrelationIdMiddleware)
+
+    @application.get("/ping")
+    def ping():
+        return {"pong": True}
+
+    return application
+
+
+def test_rate_limit_allows_under_limit():
+    with TestClient(_app(limit=3)) as c:
+        for _ in range(3):
+            assert c.get("/ping").status_code == 200
+
+
+def test_rate_limit_blocks_over_limit():
+    with TestClient(_app(limit=2)) as c:
+        c.get("/ping")
+        c.get("/ping")
+        blocked = c.get("/ping")
+        assert blocked.status_code == 429
+        assert blocked.headers["Retry-After"]
+
+
+def test_correlation_id_generated_when_absent():
+    with TestClient(_app()) as c:
+        cid = c.get("/ping").headers["X-Correlation-ID"]
+        assert cid and cid != "-"
+
+
+def test_json_formatter_emits_valid_json():
+    configure_logging("INFO")
+    token = correlation_id.set("cid-123")
+    record = logging.LogRecord("t", logging.INFO, __file__, 1, "hello", None, None)
+    payload = json.loads(JsonFormatter().format(record))
+    correlation_id.reset(token)
+    assert payload["message"] == "hello"
+    assert payload["correlation_id"] == "cid-123"
+    assert payload["level"] == "INFO"
+
+
+def test_json_formatter_includes_extra_fields():
+    record = logging.LogRecord("t", logging.INFO, __file__, 1, "m", None, None)
+    record.extra_fields = {"path": "/api/v1/predict", "status": 200}
+    payload = json.loads(JsonFormatter().format(record))
+    assert payload["path"] == "/api/v1/predict"
+    assert payload["status"] == 200
