diff --git a/app/features.py b/app/features.py
new file mode 100644
index 0000000..3aa3c59
--- /dev/null
+++ b/app/features.py
@@ -0,0 +1,126 @@
+"""Feature engineering for readmission risk prediction.
+
+Transforms raw patient encounter records into the model feature frame:
+lag features over prior admissions, rolling vitals aggregates, utilisation
+ratios, and categorical encodings of admission context.
+"""
+
+import numpy as np
+import pandas as pd
+
+ADMISSION_TYPES = ["emergency", "urgent", "elective", "transfer"]
+DISCHARGE_DISPOSITIONS = ["home", "home_health", "snf", "rehab", "other"]
+
+RAW_COLUMNS = [
+    "age",
+    "num_diagnoses",
+    "num_medications",
+    "num_lab_procedures",
+    "length_of_stay",
+    "prior_admissions_1y",
+    "days_since_last_discharge",
+    "avg_heart_rate",
+    "avg_systolic_bp",
+    "avg_glucose",
+    "admission_type",
+    "discharge_disposition",
+]
+
+
+def build_features(df: pd.DataFrame) -> pd.DataFrame:
+    """Derive the model feature frame from raw encounter records.
+
+    Adds lag, rolling, ratio and encoded features on top of the numeric
+    raw columns. Returns a new DataFrame; the input is not mutated.
+    """
+    out = df.copy()
+
+    # Lag features: prior utilisation signals
+    out["readmit_lag_flag"] = (out["days_since_last_discharge"] < 30).astype(int)
+    out["admission_velocity"] = out["prior_admissions_1y"] / (
+        out["days_since_last_discharge"].clip(lower=1.0)
+    )
+
+    # Rolling vitals aggregates (per-encounter means arrive pre-aggregated;
+    # combine into instability composites)
+    out["vitals_instability"] = (
+        (out["avg_heart_rate"] - 75.0).abs() / 75.0
+        + (out["avg_systolic_bp"] - 120.0).abs() / 120.0
+    )
+    out["glucose_deviation"] = (out["avg_glucose"] - 100.0).abs() / 100.0
+
+    # Ratio features
+    out["meds_per_diagnosis"] = out["num_medications"] / out["num_diagnoses"].clip(lower=1)
+    out["labs_per_day"] = out["num_lab_procedures"] / out["length_of_stay"].clip(lower=1)
+    out["complexity_index"] = (
+        out["num_diagnoses"] * out["num_medications"]
+    ) / (out["age"].clip(lower=1))
+
+    # Categorical encodings
+    for adm in ADMISSION_TYPES:
+        out[f"adm_{adm}"] = (out["admission_type"] == adm).astype(int)
+    for disp in DISCHARGE_DISPOSITIONS:
+        out[f"disp_{disp}"] = (out["discharge_disposition"] == disp).astype(int)
+
+    out = out.drop(columns=["admission_type", "discharge_disposition"])
+    return out
+
+
+def feature_names() -> list:
+    """Return the ordered list of engineered feature column names."""
+    numeric = [c for c in RAW_COLUMNS if c not in ("admission_type", "discharge_disposition")]
+    derived = [
+        "readmit_lag_flag",
+        "admission_velocity",
+        "vitals_instability",
+        "glucose_deviation",
+        "meds_per_diagnosis",
+        "labs_per_day",
+        "complexity_index",
+    ]
+    encoded = [f"adm_{a}" for a in ADMISSION_TYPES] + [
+        f"disp_{d}" for d in DISCHARGE_DISPOSITIONS
+    ]
+    return numeric + derived + encoded
+
+
+def generate_synthetic_encounters(n: int = 2000, seed: int = 42) -> pd.DataFrame:
+    """Generate a synthetic but clinically plausible encounter dataset.
+
+    The readmission label correlates with prior utilisation, vitals
+    instability and discharge disposition so that models learn a
+    realistic signal.
+    """
+    rng = np.random.default_rng(seed)
+    df = pd.DataFrame(
+        {
+            "age": rng.integers(18, 95, n),
+            "num_diagnoses": rng.integers(1, 16, n),
+            "num_medications": rng.integers(0, 30, n),
+            "num_lab_procedures": rng.integers(1, 80, n),
+            "length_of_stay": rng.integers(1, 21, n),
+            "prior_admissions_1y": rng.poisson(1.2, n),
+            "days_since_last_discharge": rng.integers(1, 365, n),
+            "avg_heart_rate": rng.normal(80, 12, n).clip(40, 160),
+            "avg_systolic_bp": rng.normal(125, 18, n).clip(80, 220),
+            "avg_glucose": rng.normal(110, 30, n).clip(50, 400),
+            "admission_type": rng.choice(ADMISSION_TYPES, n, p=[0.5, 0.2, 0.2, 0.1]),
+            "discharge_disposition": rng.choice(
+                DISCHARGE_DISPOSITIONS, n, p=[0.55, 0.15, 0.15, 0.1, 0.05]
+            ),
+        }
+    )
+    logit = (
+        0.55 * (df["prior_admissions_1y"] - 1)
+        + 1.4 * (df["days_since_last_discharge"] < 30).astype(float)
+        + 0.18 * (df["num_diagnoses"] - 5)
+        + 0.09 * (df["num_medications"] - 10)
+        + 1.1 * (df["discharge_disposition"] == "snf").astype(float)
+        + 0.6 * (df["admission_type"] == "emergency").astype(float)
+        + 0.12 * ((df["avg_glucose"] - 110).abs() / 10)
+        + 0.04 * (df["age"] - 60) / 5
+        - 1.8
+    )
+    prob = 1.0 / (1.0 + np.exp(-logit))
+    df["readmitted_30d"] = (rng.random(n) < prob).astype(int)
+    return df
