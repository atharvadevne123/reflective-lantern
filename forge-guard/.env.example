# Forge-Guard — environment variable template
# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://forge:forge123@localhost:5432/forge_guard
# For local development without Docker, use SQLite:
# DATABASE_URL=sqlite:///./forge_guard.db

POSTGRES_PASSWORD=forge123

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=/app/model.joblib
METRICS_PATH=/app/metrics.json
MODEL_VERSION=1.0.0

# ── API ───────────────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
CORS_ORIGINS=*

# ── Retraining Pipeline ───────────────────────────────────────────────────────
RETRAIN_MIN_SAMPLES=500
DRIFT_THRESHOLD=0.3
