# --- Core ---
DATABASE_URL=postgresql://cyber:guard@localhost:5432/cyberguard
MODEL_PATH=model.joblib
METRICS_PATH=metrics.json
ANOMALY_MODEL_PATH=anomaly_model.joblib
LOG_LEVEL=INFO
API_VERSION=1.0.0

# --- Drift monitoring ---
# KS-test p-value below which drift is reported.
DRIFT_P_THRESHOLD=0.05
# Days of history used as the reference distribution.
REFERENCE_WINDOW_DAYS=7

# --- API limits ---
RATE_LIMIT_PER_MINUTE=120

# --- Retraining ---
# A retrained model below this cross-validated accuracy is not promoted.
RETRAIN_ACCURACY_FLOOR=0.70

# --- Optional: MLflow experiment tracking ---
# Leave MLFLOW_TRACKING_URI empty to disable tracking entirely.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=cyber-guard

# --- Optional: S3 model artifact storage ---
# Leave S3_BUCKET empty to keep artifacts on the local filesystem.
S3_BUCKET=
S3_PREFIX=cyber-guard/models
AWS_REGION=us-east-1
