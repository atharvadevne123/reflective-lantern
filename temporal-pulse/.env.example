# ============================================================
# Temporal-Pulse Environment Variables — copy to .env
# ============================================================

# --- Database ---
# PostgreSQL DSN (used in production via docker-compose)
DATABASE_URL=postgresql://tp_user:tp_password@localhost:5432/temporal_pulse
# Use SQLite for local development:
# DATABASE_URL=sqlite:///./temporal_pulse.db

# --- Model ---
# Directory where trained model artifacts are persisted
MODEL_DIR=/tmp/temporal_pulse_models

# Isolation Forest contamination rate (fraction of expected anomalies)
# Must be between 0.01 and 0.50
ANOMALY_THRESHOLD=0.7

# --- API ---
# Comma-separated list of allowed CORS origins (* = all)
CORS_ORIGINS=*

# Number of uvicorn worker processes
WORKERS=2

# --- Retraining Pipeline ---
# How many days of readings to use for retraining
RETRAIN_LOOKBACK_DAYS=30

# Minimum number of readings required to trigger a retrain
RETRAIN_MIN_SAMPLES=500
