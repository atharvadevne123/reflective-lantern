# Quake-Net Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://quake_user:quake_pass@localhost:5432/quake_net

# Model paths
MODEL_PATH=model.joblib
METRICS_PATH=metrics.json
REFERENCE_PATH=reference_dist.json

# Monitoring
DRIFT_WINDOW=200
DRIFT_ALPHA=0.05

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
