# Veritas-Rag environment variables — copy to .env and adjust

# Generation backend: "extractive" (offline, zero-hallucination by construction)
# or "anthropic" (fluent abstractive answers under the same grounding contract)
GENERATOR_BACKEND=extractive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Retrieval tuning
EMBEDDING_DIM=384
CHUNK_SIZE=800
CHUNK_OVERLAP=150
BM25_TOP_K=50
VECTOR_TOP_K=50
RERANK_TOP_K=20
FINAL_TOP_K=5

# Hallucination gate
CONFIDENCE_THRESHOLD=0.45
CHUNK_TRUST_FLOOR=0.35
MIN_SUPPORTING_CHUNKS=1
FRESHNESS_HALF_LIFE_DAYS=365

# Dedup
NEAR_DUP_THRESHOLD=0.85

# Caching & observability
CACHE_MAX_SIZE=2048
CACHE_TTL_SECONDS=300
TRACE_BUFFER_SIZE=1000

LOG_LEVEL=INFO
