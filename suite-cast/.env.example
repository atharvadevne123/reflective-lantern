# Suite-Cast environment variables
# Copy to .env and fill in values before running

# Database
DATABASE_URL=sqlite:///./suite_cast.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://suite_cast:yourpassword@localhost:5432/suite_cast

# Model configuration
MODEL_VERSION=1.0.0
MODEL_PATH=model.joblib
BASE_ROOM_RATE=150.0

# API settings
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: PostgreSQL direct connection params
POSTGRES_USER=suite_cast
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=suite_cast
