# Support-Sage environment configuration
# Copy to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./support_sage.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://support_sage:password@localhost:5432/support_sage

# API
PORT=8000
LOG_LEVEL=INFO

# Model paths (optional overrides)
MODEL_PATH=models/priority_model.joblib
ENCODER_PATH=models/priority_encoder.joblib
REGRESSOR_PATH=models/resolution_model.joblib

# Drift detection
DRIFT_WINDOW_DAYS=7
DRIFT_P_VALUE_THRESHOLD=0.05
