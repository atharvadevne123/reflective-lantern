# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signal_forge

# Model storage paths
MODEL_PATH=/app/models/signal_forge_model.pkl
FAISS_INDEX_PATH=/app/models/signal_forge.faiss

# API settings
APP_ENV=production
LOG_LEVEL=INFO

# Drift detection thresholds
DRIFT_KS_THRESHOLD=0.05
REFERENCE_WINDOW_DAYS=30
MONITOR_WINDOW_DAYS=7
