# Database
DATABASE_URL=postgresql://ops:ops@localhost:5432/opsvision

# ML Model paths
MODEL_PATH=/tmp/ops_vision_model.pkl
FEATURE_PIPELINE_PATH=/tmp/ops_vision_pipeline.pkl

# FAISS runbook index
FAISS_INDEX_PATH=/tmp/ops_vision_faiss.index
RUNBOOKS_PATH=data/runbooks/sample_runbooks.json
EMBEDDING_DIM=64

# Drift monitoring
REFERENCE_WINDOW_SIZE=1000
CURRENT_WINDOW_SIZE=200
DRIFT_THRESHOLD=0.05

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Application
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=["*"]
