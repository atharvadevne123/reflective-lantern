# Price-Prophet Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# === Database ===
DATABASE_URL=sqlite:///./price_prophet.db
# For PostgreSQL: postgresql://user:password@localhost:5432/price_prophet
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# === API Settings ===
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# === Model Settings ===
MODEL_PATH=model.joblib
METRICS_PATH=metrics.json

# === Feature Flags ===
ENABLE_DRIFT_DETECTION=true
DRIFT_P_THRESHOLD=0.05
REFERENCE_WINDOW_SIZE=500
