# Ticket-Oracle environment variables
# Copy to .env and fill in values before running locally or in Docker.

# Database connection (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./ticket_oracle.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ticketoracle

# Model artefact directory
MODEL_DIR=models

# Semantic version tag embedded in each prediction response
MODEL_VERSION=1.0.0

# FastAPI / uvicorn
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2

# Optional: MLflow tracking server
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: AWS S3 bucket for model artefact backup
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ticket-oracle-models
