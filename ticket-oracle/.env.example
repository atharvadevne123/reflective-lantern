# Ticket-Oracle environment configuration
# Copy to .env and fill in values for local development.
# Never commit a .env file with real credentials.

# --- Model ---
MODEL_DIR=models

# --- API ---
API_RATE_LIMIT=60/minute
MAX_BATCH_SIZE=100
REQUEST_TIMEOUT_SECONDS=30.0

# --- Cache ---
CACHE_MAXSIZE=512
CACHE_TTL_SECONDS=300.0

# --- Database ---
# Local SQLite (default):
DATABASE_URL=sqlite:///./ticket_oracle.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ticket_oracle

# --- Monitoring ---
DRIFT_WINDOW_HOURS=24
SPIKE_Z_THRESHOLD=2.5

# --- Logging ---
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
