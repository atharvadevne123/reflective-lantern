# Fleet-Mind environment variables — copy to .env and fill in values

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, for local dev):
DATABASE_URL=sqlite:///./fleet_mind.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://fleet:secret@localhost:5432/fleet_mind

# ── Model persistence ────────────────────────────────────────────────────────
MODEL_PATH=/tmp/fleet_mind_model.joblib
METRICS_PATH=/tmp/fleet_mind_metrics.json

# ── Drift monitoring ─────────────────────────────────────────────────────────
# KS-test p-value threshold; features with p < threshold are flagged
DRIFT_THRESHOLD=0.05
# Number of recent predictions to compare against baseline
DRIFT_WINDOW=500

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to true to emit JSON-formatted logs (recommended for production)
LOG_JSON=false

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100

# ── PostgreSQL (used by docker-compose) ──────────────────────────────────────
POSTGRES_PASSWORD=fleet_secret
