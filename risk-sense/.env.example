# Risk-Sense environment configuration

# Database
DATABASE_URL=postgresql://risk_sense:risk_sense_pass@localhost:5432/risk_sense
# For local SQLite testing:
# DATABASE_URL=sqlite:///./risk_sense.db

# Model persistence
MODEL_PATH=/app/models/risk_sense_model.pkl
PIPELINE_PATH=/app/models/risk_sense_pipeline.pkl

# API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Drift detection thresholds
DRIFT_KS_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.25
MIN_SAMPLES_FOR_DRIFT=10

# Retraining
RETRAIN_INTERVAL_HOURS=24
MIN_RECORDS_FOR_RETRAIN=500
