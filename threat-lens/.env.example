# Threat-Lens environment configuration

# Database
DATABASE_URL=postgresql://threatuser:threatpass@db:5432/threatlens

# Model paths
MODEL_PATH=model.joblib
METRICS_PATH=metrics.json

# API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Monitoring
DRIFT_THRESHOLD=0.05
REFERENCE_WINDOW=500

# Optional: MLflow tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
MAX_BATCH_SIZE=100

# Experiment tracking (falls back to local JSONL when unset)
EXPERIMENT_LOG=experiment_runs.jsonl

# Model artefact storage (falls back to in-memory when unset)
S3_BUCKET=
