{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reflective Lantern Run History Entry",
  "description": "Schema for individual run log entries stored in history/<repo>.json",
  "oneOf": [
    { "$ref": "#/definitions/entry" },
    {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    }
  ],
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["commits"],
      "anyOf": [
        { "required": ["date"] },
        { "required": ["last_run"] }
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "ISO-8601 date of this run (YYYY-MM-DD)"
        },
        "last_run": {
          "type": "string",
          "format": "date",
          "description": "Alternative date field used by some older entries"
        },
        "mode": {
          "type": "string",
          "enum": ["improvement", "IMPROVEMENT", "innovation", "INNOVATION"],
          "description": "Run mode"
        },
        "commits": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of commits pushed this run"
        },
        "tests_passed": {
          "type": "boolean",
          "description": "Whether the test suite passed after improvements"
        },
        "improvements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of human-readable improvement descriptions"
        },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Improvements grouped by tier (Performance, Security, etc.)"
        },
        "email_status": {
          "type": "string",
          "description": "Email send outcome: 'sent', 'pending', or error message"
        },
        "repo": {
          "type": "string",
          "description": "Repository name (redundant but present in some formats)"
        }
      },
      "additionalProperties": true
    }
  }
}
