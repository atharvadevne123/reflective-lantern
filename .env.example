# Reflective Lantern — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ─────────────────────────────────────────────────────────────────
# Personal Access Token with repo + workflow scopes
GH_PAT=ghp_...
GITHUB_USERNAME=your-github-username

# ── Notion ─────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...
# The database ID for your Case Studies table
NOTION_DATABASE_ID=your-database-id

# ── Gmail (App Password) ───────────────────────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
REPORT_RECIPIENT=you@gmail.com

# ── Logging ────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to 1 to emit structured JSON logs
JSON_LOGS=0

# ── Run settings ───────────────────────────────────────────────────────────
# Max seconds to spend fixing a single failing workflow
PF_FIX_TIMEOUT=300
# Commits required per run
COMMIT_TARGET=60

# ── Optional overrides ─────────────────────────────────────────────────────
# Override the default GitHub API base URL (useful for GitHub Enterprise)
# GITHUB_API_BASE=https://api.github.com
# Override the Claude model used for Notion portfolio descriptions
# NOTION_MODEL=claude-sonnet-4-6

# ── Report settings ────────────────────────────────────────────────────────
# Prefix prepended to every outgoing email subject line
# REPORT_SUBJECT_PREFIX=[Reflective Lantern]
# Set to 1 to skip writes, emails, and file modifications (preview mode)
# DRY_RUN=0

# ── Palantir Foundry ───────────────────────────────────────────────────────
# Foundry stack hostname, e.g. https://mystack.palantirfoundry.com
# FOUNDRY_HOSTNAME=
# Foundry bearer token (third-party app or user token)
# FOUNDRY_TOKEN=
# Target dataset RID for history exports, e.g. ri.foundry.main.dataset.xxxx
# FOUNDRY_DATASET_RID=
# Dataset branch to write to (defaults to master)
# FOUNDRY_BRANCH=master
