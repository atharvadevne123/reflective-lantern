# Watt-Guard environment variables — copy to .env and fill in values
# -------------------------------------------------------------------

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./watt_guard.db
# DATABASE_URL=postgresql://wattguard:wattguard@localhost:5432/wattguard

# PostgreSQL connection pool (ignored for SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Model artefact paths
MODEL_PATH=model.joblib
ANOMALY_MODEL_PATH=anomaly_model.joblib
METRICS_PATH=metrics.json

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=200

# Airflow / Retraining pipeline (optional)
AIRFLOW_HOME=~/airflow
R2_GATE=0.70
MIN_TRAINING_ROWS=500

# Database connection pool (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# CORS allowed origins (comma-separated or *)
CORS_ORIGINS=*
