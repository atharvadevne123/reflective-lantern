# Application
LOG_LEVEL=INFO
MODEL_VERSION=1.0.0

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./logistics_flow.db
# DATABASE_URL=postgresql://logistics:logistics@localhost:5432/logistics_flow

# Model artifacts
MODEL_PATH=model.joblib
FEATURE_PIPELINE_PATH=feature_pipeline.joblib
METRICS_PATH=metrics.json

# Security
SECRET_KEY=change-me-in-production
API_KEY=optional-api-key

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT_S=30

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_S=60

# Drift detection
DRIFT_KS_THRESHOLD=0.05
REFERENCE_BUFFER_SIZE=500
