# ── Application ───────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Semantic version embedded in /api/v1/health and prediction responses
MODEL_VERSION=1.0.0

# Per-process sliding-window rate limit (requests per minute, default: 120)
RATE_LIMIT_PER_MINUTE=120

# Number of predictions to buffer for KS-test drift detection (default: 100)
DRIFT_WINDOW=100

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development; switch to PostgreSQL for staging/production
DATABASE_URL=sqlite:///./logistics_flow.db
# DATABASE_URL=postgresql://logistics:logistics@localhost:5432/logistics_flow

# ── Model artifacts ───────────────────────────────────────────────────────────
# Path to the serialised XGBoost/LightGBM/RandomForest ensemble (joblib)
MODEL_PATH=model.joblib

# Path to the fitted feature-engineering pipeline (joblib)
FEATURE_PIPELINE_PATH=feature_pipeline.joblib

# Path to the JSON file storing training metrics (RMSE, MAE, R²)
METRICS_PATH=metrics.json
