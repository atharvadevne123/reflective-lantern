# Database
DATABASE_URL=postgresql://cyber:sentinel@localhost:5432/cybersentinel

# Model storage
MODEL_PATH=/tmp/cyber_sentinel_model.pkl
LABEL_ENCODER_PATH=/tmp/cyber_sentinel_le.pkl

# API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Drift detection
DRIFT_THRESHOLD=0.05

# Airflow
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://airflow:airflow@postgres/airflow
