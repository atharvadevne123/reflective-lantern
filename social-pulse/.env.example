# Social-Pulse environment variables
# Copy to .env and fill in values before running

# Database
# For local SQLite (development): leave empty or set to sqlite:///./social_pulse.db
# For PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./social_pulse.db

# Model
# Directory where trained model artifacts are persisted
MODEL_DIR=/tmp/social_pulse_models

# API
# Semantic version string served in /health and /version responses
MODEL_VERSION=1.0.0

# Logging
# Set to DEBUG for verbose output; INFO for production
LOG_LEVEL=INFO
