# Alpha-Scout environment variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL=sqlite:///./alpha_scout.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/alphascout

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Model
MODEL_VERSION=1.0.0
MODEL_PATH=model.joblib
RETRAIN_SCHEDULE=weekly

# Monitoring
DRIFT_P_VALUE_THRESHOLD=0.05
MAX_PREDICTION_LOG=10000

# Logging
LOG_LEVEL=INFO
